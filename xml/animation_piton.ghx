                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
from Rhino.Geometry import Point3d

class MyComponent(component):
    def __init__(self):
        self.m_startPoint = []
    
    def RunScript(self, ):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.09.29"
        
        import rhinoscriptsyntax as rs
        if len(self.m_startPoint) == 0:
            obj = rh.RhinoDoc.ActiveDoc.Objects.FindByLayer("START_POINT")
            self.m_startPoint = [None] * len(obj)
            for o in obj:
                #print o.GetType()
                #print rh.DocObjects.PointObject.PointGeometry.GetValue()
                #print o.PointGeometry.Location.GetType()
                index = int(rs.GetUserText(o,"StartPoint"))
                self.m_startPoint[index] = o
            #Rhino.Geometry.Point.
        # return outputs if you have them; here I try it for you:
        return self.m_startPoint
</item>
