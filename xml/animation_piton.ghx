                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs
import sys
import itertools
from Rhino.Geometry import Point3d

cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)

import Agent
Agent = reload(Agent)

class MyComponent(component):
    def __init__(self):
        self.isRun = False
        self.agentList = None
        self.isAgentInitialized = False
        
    def InitalizeAgent(self, agentPos,initialState):
        self.agentList = []
        for index,(pos,state) in enumerate(itertools.izip_longest(agentPos,initialState)):
            #agent = Agent(pos)
            if index &lt; len(agentPos):
                tState = Agent.STATE_IDLE
                if index &lt; len(initialState):
                    tState = state
                #print pos
                agent = Agent.Agent(pos,Point3d(0,0,0),state)
                self.agentList.append(agent)
                print agent.pos
        self.isAgentInitialized = True
        
    def RunScript(self, agentPos, initialState, reset):
        print reset
        if reset:
            self.isAgentInitialized = False
            return None
            
        if (not self.isRun) and (not reset):
            self.isRun = True
            self.agentList = None
            
        if not self.isAgentInitialized:
            self.InitalizeAgent(agentPos, initialState)
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.03.24"
        
        import rhinoscriptsyntax as rs
        
        #for index,(pos,state) in enumerate(itertools.izip_longest(agentPos,initialState)):
            #agent = Agent(pos)
            #if index &lt; len(agentPos):
                #tState = Agent.STATE_IDLE
                #if index &lt; len(initialState):
                    #tState = state
                #print pos
                #agent = Agent.Agent(pos,Point3d(0,0,0),state)
                #agentList.append(agent)
        
        # return outputs if you have them; here I try it for you:
        return self.agentList
