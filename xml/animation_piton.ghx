            <chunk name="Object" index="9">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">a9a8ebd2-fff5-4c44-a8f5-739736d129ba</item>
                <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="6">
                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    if(!activate) return;

    List&lt;Guid&gt; guids = new List&lt;Guid&gt;();

    for(int i = 0; i &lt; geometry.Count; i++){

      Rhino.DocObjects.ObjectAttributes att = new Rhino.DocObjects.ObjectAttributes();

      Rhino.Display.DisplayMaterial shader = new Rhino.Display.DisplayMaterial();

      if(material.Count == geometry.Count){
        shader = (Rhino.Display.DisplayMaterial) material[i];
      }else if(material.Count &gt; 0){
        shader = (Rhino.Display.DisplayMaterial) material[0];
      }

      Rhino.DocObjects.Material mat = new Rhino.DocObjects.Material();

      mat.AmbientColor = shader.Ambient;
      mat.DiffuseColor = shader.Diffuse;
      mat.EmissionColor = shader.Emission;
      mat.Shine = shader.Shine;
      mat.SpecularColor = shader.Specular;
      mat.Transparency = shader.Transparency;

      string shaderName = string.Format("D{0}-E{1}-S{2}-Sp{3}-T{4}",
        shader.Diffuse.Name,
        shader.Emission.Name,
        shader.Shine,
        shader.Specular,
        shader.Transparency
        );

      mat.Name = shaderName;

      int nwMat = doc.Materials.Find(shaderName, true);
      if(nwMat &lt; 0) nwMat = doc.Materials.Add(mat);

      Print(nwMat.ToString());

      string layer = "";

      if(layers.Count == geometry.Count){
        layer = layers[i];
      }else if(layers.Count &gt; 0){
        layer = layers[0];
      }

      if(layer.Length == 0){
        att.MaterialSource = Rhino.DocObjects.ObjectMaterialSource.MaterialFromObject;
        att.MaterialIndex = nwMat;
        att.LayerIndex = doc.Layers.Find(doc.Layers.CurrentLayer.Id, true);
      }else{
        att.MaterialSource = Rhino.DocObjects.ObjectMaterialSource.MaterialFromLayer;
        int layInd = doc.Layers.Find(layer, true);
        if(layInd &lt; 0){
          Rhino.DocObjects.Layer l = new Rhino.DocObjects.Layer();
          l.Color = mat.DiffuseColor;
          l.Name = layer;
          l.RenderMaterialIndex = nwMat;
          layInd = doc.Layers.Add(l);
        }
        att.LayerIndex = layInd;
      }

      Guid id = Guid.Empty;

      if(geometry[i].ObjectType == Rhino.DocObjects.ObjectType.Brep) id = doc.Objects.AddBrep((Brep) geometry[i], att);
      if(geometry[i].ObjectType == Rhino.DocObjects.ObjectType.Surface) id = doc.Objects.AddSurface((Surface) geometry[i], att);
      if(geometry[i].ObjectType == Rhino.DocObjects.ObjectType.Mesh) id = doc.Objects.AddMesh((Mesh) geometry[i], att);

      if(id.ToString().Length &gt; 0) guids.Add(id);

    }

    string savedLocation = filePath + "\\r" + current.ToString("0000000") + ".png";

    Rhino.RhinoApp.RunScript("_-Render", false);
    //Rhino.RhinoApp.RunScript("_-SaveRenderWindowAs \n\"" + savedLocation + "\"\n", false);
    Rhino.RhinoApp.RunScript("_-CloseRenderWindow", false);

    for(int i = 0; i &lt; guids.Count; i++) doc.Objects.Delete(guids[i], true);

</item>
