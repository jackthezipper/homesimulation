                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
import scriptcontext as sc
import sys
import time

import System
import Rhino.UI
import Eto.Drawing as drawing
import Eto.Forms as forms

cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)
    
import Agent
#Agent = reload(Agent)

import HomeObject
HomeObject = reload(HomeObject)

class AgentInfo(forms.Form):
    def __init__(self):
        self.myAgent = None
        
        self.Title = "Agent Info"
        self.Padding = drawing.Padding(10)
        
        self.layout = forms.DynamicLayout()
        self.layout.Spacing = drawing.Size(5,5)
        self.layout.Padding = drawing.Padding(10)
        
        nLabel = forms.Label()
        
        self.layout.AddRow(nLabel)
        
        self.Content = self.layout
    
    def SetAgent(self,agent):
        self.myAgent = agent
        
    def UpdateForm(self):
        layout = forms.DynamicLayout()
        layout.Spacing = drawing.Size(5,5)
        layout.Padding = drawing.Padding(10)
        
        nLabel = forms.Label(Text = str(self.myAgent.pos))
        
        sc.doc = rh.RhinoDoc.ActiveDoc
        
        for obj in self.myAgent.objectList:
            objectFound = False
            #print len(HomeObject.HomeObject.HomeObjectList)
            for hObject in HomeObject.HomeObject.HomeObjectList:
                #print hObject
                if hObject.IsPartFromThis(obj):
                    objectFound = True
                    break
            displayText = rs.BlockInstanceName(obj.Id)
            if objectFound and hObject.HasTarget():
                amountOccupied,amountTarget = hObject.Occupied()
                if amountTarget == 1:
                    if amountOccupied != 0:
                        displayText += " : OCCUPIED"
                    else:
                        displayText += " : FREE"
                else:
                    if amountTarget == amountOccupied:
                        displayText += (" : FULL CAPACITY "+str(amountOccupied)+"/"+str(amountTarget))
                    else:
                        displayText += (" : "+str(amountTarget - amountOccupied)+" AVAILABLE FROM "+str(amountTarget)+" SPACE")
            nLabel = forms.Label(Text = displayText)
            layout.AddRow(nLabel)
        sc.doc = ghdoc
        #layout.AddRow(nLabel)
        self.Content = layout

class MyComponent(component):
    def __init__(self):
        self.myAgentInfo = []
        self.formCreated = False
        self.formShow = False
        
    def ShowForm(self):
        for agentInfo in self.myAgentInfo:
            agentInfo.Show()
        self.formShow = True
    
    def InitForm(self,agents):
        for agent in agents:
            if agent.m_active:
                agentInfo = AgentInfo()
                agentInfo.SetAgent(agent)
                agentInfo.UpdateForm()
                self.myAgentInfo.append(agentInfo)
        #ferom = forms.Form()
        self.formCreated = True
        
    def UpdateForm(self,agent):
        layout = forms.DynamicLayout()
        layout.Spacing = drawing.Size(5,5)
        layout.Padding = drawing.Padding(10)
        
        if agent == None or len(agent) == 0 or agent[1] == None:
            nLabel = forms.Label(Text = "No Agent")
            layout.AddRow(nLabel)
        else:
            nLabel = forms.Label(Text = str(agent[1].pos))
            
            sc.doc = rh.RhinoDoc.ActiveDoc
        
            for obj in agent[1].objectList:
                objectFound = False
                #print len(HomeObject.HomeObject.HomeObjectList)
                for hObject in HomeObject.HomeObject.HomeObjectList:
                    print hObject
                    if hObject.IsPartFromThis(obj):
                        objectFound = True
                        break
                displayText = rs.BlockInstanceName(obj.Id)
                if hObject.HasTarget():
                    amountOccupied,amountTarget = hObject.Occupied()
                    if amountTarget == 1:
                        if amountOccupied != 0:
                            displayText += " : OCCUPIED"
                        else:
                            displayText += " : FREE"
                    else:
                        if amountTarget == amountOccupied:
                            displayText += (" : FULL CAPACITY "+str(amountOccupied)+"/"+str(amountTarget))
                        else:
                            displayText += (" : "+str(amountTarget - amountOccupied)+" AVAILABLE FROM "+str(amountTarget)+" SPACE")
                nLabel = forms.Label(Text = displayText)
                layout.AddRow(nLabel)
            sc.doc = ghdoc
        #layout.AddRow(nLabel)
        self.myAgentInfo.Content = layout
    
    def RunScript(self, x, y,reset, objectInView):
        print reset
        if reset:
            self.formCreated = False
            self.formShow = False
            for agentInfo in self.myAgentInfo:
                if agentInfo != None:
                    agentInfo.Close()
            self.myAgentInfo = []
            return None
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "andri.setiawan"
        __version__ = "2020.06.13"
        
        import rhinoscriptsyntax as rs
        
        for (i,agt) in enumerate(x):
            if agt != None:
               agt.objectList = objectInView[i]
        
        if not self.formCreated:
            self.InitForm(x)
            
        
        #ferom.Show()
        for agentInfo in self.myAgentInfo:
            agentInfo.UpdateForm()
        if not self.formShow:
            self.ShowForm()
        #forms.Form.Sh
        
        # return outputs if you have them; here I try it for you:
        timeRS1 = int(time.time() * 1000)
        print str(timeRS1 - sc.sticky["StartFrame"])
        return None
