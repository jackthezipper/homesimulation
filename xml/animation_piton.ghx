              <chunks count="1">
                <chunk name="Container">
                  <items count="11">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs
import sys
import itertools
import scriptcontext as sc
from Rhino.Geometry import Point3d

import csv

cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)

import Agent
Agent = reload(Agent)
import Activity
Activity = reload(Activity)
import Global

class MyComponent(component):
    def __init__(self):
        self.m_isRun = False
        self.m_agentList = None
        self.m_isAgentInitialized = False
        
    def InitalizeAgent(self, agentPos, ActiveAgent):
        self.m_agentList = []
        for index,pos in enumerate(agentPos):
            if index &lt; len(agentPos) and ActiveAgent[index]:
                tState = Agent.STATE_IDLE
                role = rs.GetUserText(pos,"Role")
                agent = Agent.Agent(pos.PointGeometry.Location,Point3d(0,0,0),index,role,Agent.STATE_IDLE)
                agent.m_active = ActiveAgent[index]
                self.m_agentList.append(agent)
        self.m_isAgentInitialized = True
        
    def RunScript(self, rooms, agentPos, ActiveAgent, reset):
        if reset:
            self.m_isAgentInitialized = False
            return None
            
        if (not self.m_isRun) and (not reset):
            self.m_isRun = True
            self.m_agentList = None
            
        if not self.m_isAgentInitialized:
            Global.g_timer.ResetTimer()
            Global.g_myHouse.ResetEnergyUsage()
            Activity.LoadMultiAgent()
            self.InitalizeAgent(agentPos, ActiveAgent)
            for agent in Agent.Agent.agentList:
                print agent.m_socialValue
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.03.24"
        
        import rhinoscriptsyntax as rs
        
        # return outputs if you have them; here I try it for you:
        return self.m_agentList
</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
                    <item name="EditorLocation" type_name="gh_drawing_point" type_code="30">
                      <X>140</X>
