            <chunk name="Object" index="20">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">a9a8ebd2-fff5-4c44-a8f5-739736d129ba</item>
                <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="AdditionalSource" type_name="gh_string" type_code="10">  bool isInitialized = false;
  List&lt;List&lt;Rhino.DocObjects.RhinoObject&gt;&gt; wallList = new List&lt;List&lt;Rhino.DocObjects.RhinoObject&gt;&gt;();
  List&lt;List&lt;Rhino.Geometry.Curve&gt;&gt; wallListCurve = new List&lt;List&lt;Rhino.Geometry.Curve&gt;&gt;();
  List&lt;double&gt; diagL = new List&lt;double&gt;();
  List&lt;Rhino.Geometry.PolylineCurve&gt; rectCurve = new List&lt;Rhino.Geometry.PolylineCurve&gt;();
  List&lt;Rhino.Geometry.Polyline&gt; rectArea = new List&lt;Rhino.Geometry.Polyline&gt;();
  List&lt;List&lt;Rhino.DocObjects.RhinoObject&gt;&gt; objectInViewField = new List&lt;List&lt;Rhino.DocObjects.RhinoObject&gt;&gt;();
  String lastError = "No error";</item>
                    <item name="CustomUsing" type_name="gh_bool" type_code="1">true</item>
                    <item name="Description" type_name="gh_string" type_code="10">A C#.NET scriptable component</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>268</X>
                      <Y>69</Y>
                    </item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">9f5d65c4-29df-4b99-81a1-66b6900b0713</item>
                    <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">AgentViewUpdater</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">    //Rhino.RhinoDoc.ActiveDoc.Views.ActiveView
    Print(lastError);
    var ll = Rhino.RhinoDoc.ActiveDoc.Layers.FindByFullPath("ARS-Dinding", -1);
    Print("dene " + ll);
    if(!isInitialized)
    {
      
      //foreach 
      int wallLayerIdx = Rhino.RhinoDoc.ActiveDoc.Layers.FindByFullPath("ARS-Dinding", -1);
      foreach(Rectangle3d rct in Rect)
      {
        Polyline pl = rct.ToPolyline();
        List&lt;Rhino.DocObjects.RhinoObject&gt; wList = Rhino.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(Rhino.RhinoDoc.ActiveDoc.Views.ActiveView.ActiveViewport, pl, true, Rhino.DocObjects.ObjectType.Curve).Where(elm =&gt; elm.Attributes.LayerIndex == wallLayerIdx).ToList();
        wallList.Add(wList);
        List&lt;Rhino.Geometry.Curve&gt; wListCurve = new List&lt;Rhino.Geometry.Curve&gt;();
        foreach(Rhino.DocObjects.RhinoObject wall in wList)
        {
          wListCurve.Add(((Rhino.DocObjects.CurveObject) wall).CurveGeometry);
        }
        wallListCurve.Add(wListCurve);
        diagL.Add(Point3d.Subtract(pl.ElementAt(0), pl.ElementAt(2)).Length);
        rectCurve.Add(pl.ToPolylineCurve());
        rectArea.Add(pl);
      }
      isInitialized = true;
    }
    Print("onoy " + isInitialized);
    objectInViewField.Clear();
    //ro.
    //RhinoObject r;
    //r.
    DateTime t1 = DateTime.Now;
    //myDir.Rotate(RhinoMath.ToRadians(-90), Vector3d.ZAxis);

    for(int i = 0;i &lt; Dir.Count;i++)
    {
      if(!ActiveAgent.ElementAt(i))
      {
        objectInViewField.Add(new List&lt;Rhino.DocObjects.RhinoObject&gt;());
        continue;
      }

      Vector3d tmp = new Vector3d(Dir.ElementAt(i));
      tmp.Rotate(RhinoMath.ToRadians(-60), Vector3d.ZAxis);
      Line l1 = new Line(Pos[i], tmp, diagL[Floor[i]]);

      tmp.Rotate(RhinoMath.ToRadians(120), Vector3d.ZAxis);
      Line l2 = new Line(Pos[i], tmp, diagL[Floor[i]]);

      tmp.Rotate(RhinoMath.ToRadians(-120), Vector3d.ZAxis);

      Rhino.Geometry.PolylineCurve curFloorArea = rectCurve.ElementAt(Floor[i]);
      Rhino.Geometry.Polyline curFloorPl = rectArea.ElementAt(Floor[i]);
      var iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(curFloorArea, l1.ToNurbsCurve(), 0, 0);
      Point3d point1 = new Point3d(0, 0, 0);
      for(int j = 0;j &lt; iSect.Count;j++)
      {
        point1 = iSect.ElementAt(j).PointA;
      }
      //Print("puki " + point1);
      iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(curFloorArea, l2.ToNurbsCurve(), 0, 0);
      Point3d point2 = new Point3d(0, 0, 0);
      for(int j = 0;j &lt; iSect.Count;j++)
      {
        point2 = iSect.ElementAt(j).PointA;
      }

      List&lt;Point3d&gt; pointList = new List&lt;Point3d&gt;();
      List&lt;Tuple&lt;Point3d,double&gt;&gt; vpointList = new List&lt;Tuple&lt;Point3d,double&gt;&gt;();
      for(int j = 0;j &lt; curFloorPl.Count - 1;j++)
      {
        Vector3d dir = Point3d.Subtract(curFloorPl.ElementAt(j), Pos[i]);
        dir.Unitize();
        double angle = RhinoMath.ToDegrees(Math.Atan2(dir.Y, dir.X) - Math.Atan2(tmp.Y, tmp.X));
        //Print("elus " + angle);
        if(angle &gt;= 0 &amp;&amp; angle &lt;= 120)
        {
          vpointList.Add(Tuple.Create(curFloorPl.ElementAt(j), angle));
        }
        //pointList
      }

      vpointList = vpointList.OrderByDescending(elm =&gt; elm.Item2).ToList();
      pointList.Add(Pos[i]);
      pointList.Add(point2);
      for(int j = 0;j &lt; vpointList.Count();j++)
      {
        pointList.Add(vpointList.ElementAt(j).Item1);
      }
      pointList.Add(point1);
      pointList.Add(Pos[i]);

      Polyline viewArea = new Polyline(pointList);
      PolylineCurve viewAreaCurve = viewArea.ToPolylineCurve();

      List&lt;Rhino.Geometry.Curve&gt; checkWallList = new List&lt;Rhino.Geometry.Curve&gt;(wallListCurve[Floor[i]]);
      List&lt;Tuple&lt;Point3d,Point3d,double,double&gt;&gt; pointToConsiderate = new List&lt;Tuple&lt;Point3d,Point3d,double,double&gt;&gt;();

      Vector3d vDir = new Vector3d(tmp);
      Tuple&lt;Point3d,Point3d,double,double&gt; tmpTuple;
      int looper = 0;
      int AddWall = 0;
      int oriWall = checkWallList.Count();
      int loop = 0;
      String lastWall = "";
      while(checkWallList.Count() &gt; 0)
      {
        looper += 1;
        if(looper &gt; 1000)
        {
          lastError = "Wall ono error: ori " + oriWall + " addw " + AddWall + " lastloop " + loop + " " + lastWall;
          return;
        }
        Rhino.Geometry.Curve curWall = checkWallList.ElementAt(0);
        checkWallList.RemoveAt(0);
        iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve, curWall, 0, 0);

        pointToConsiderate.Clear();
        foreach (Rhino.Geometry.Intersect.IntersectionEvent sect in iSect)
        {
          double posPointC;
          viewAreaCurve.ClosestPoint(sect.PointA, out posPointC);
          double posPointW;
          curWall.ClosestPoint(sect.PointA, out posPointW);
          double testPos = Math.Round(posPointW) - posPointW;
          if(Math.Abs(testPos) &gt; 0.05)
          {
            pointToConsiderate.Add(Tuple.Create(sect.PointA, sect.PointA, posPointC, posPointW));
          }
        }
        Polyline pll;
        curWall.TryGetPolyline(out pll);

        foreach(Point3d p in pll)
        {
          vDir = Point3d.Subtract(p, Pos[i]);
          double angle = RhinoMath.ToDegrees(Vector3d.VectorAngle(vDir, Dir[i]));
          if(angle &gt; 60)
          {
            continue;
          }
          Rhino.Geometry.PointContainment pointPos = viewAreaCurve.Contains(p);
          //Print("peplos " + pointPos);
          if(pointPos == Rhino.Geometry.PointContainment.Inside)
          {
            Line line = new Line(Pos[i], vDir, diagL[Floor[i]]);
            iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve, line.ToNurbsCurve(), 0, 0);
            foreach (Rhino.Geometry.Intersect.IntersectionEvent sect in iSect)
            {
              if(!sect.PointA.Equals(Pos[i]))
              {
                double posPointC;
                viewAreaCurve.ClosestPoint(sect.PointA, out posPointC);
                double posPointW;
                curWall.ClosestPoint(p, out posPointW);
                //Print("penpendar ");
                pointToConsiderate.Add(Tuple.Create(p, sect.PointA, posPointC, posPointW));
                //Print("perotak "+pointToConsiderate.Count());
              }
            }
          }
          else if(pointPos == Rhino.Geometry.PointContainment.Coincident)
          {
            double posPointC;
            viewAreaCurve.ClosestPoint(p, out posPointC);
            double posPointW;
            curWall.ClosestPoint(p, out posPointW);
            pointToConsiderate.Add(Tuple.Create(p, p, posPointC, posPointW));
          }
          else if(iSect.Count == 0)
          {
            break;
          }
        }
        //Print("samkara " + pointToConsiderate.Count());
        if(pointToConsiderate.Count &gt; 2)
        {
          pointToConsiderate = pointToConsiderate.OrderBy(elm =&gt; elm.Item4).ToList();
          //Print();
          loop = 0;
          while(pointToConsiderate.Count() &gt; 1)
          {
            loop += 1;
            if(loop &gt; 100)
            {
              lastError = "Point error";
              return;
            }
            var curElm = pointToConsiderate.ElementAt(0);
            pointToConsiderate.RemoveAt(0);
            //Print("remkaliii");
            var nextElm = pointToConsiderate.ElementAt(0);
            if(!nextElm.Item1.Equals(curElm.Item1))
            {
              Line newWall = new Line(curElm.Item1, nextElm.Item1);
              checkWallList.Add(newWall.ToNurbsCurve());
            }
            AddWall += 1;
            lastWall = "wall " + curElm.Item1 + " to " + nextElm.Item1;
            if(nextElm.Item1.Equals(nextElm.Item2))
            {
              pointToConsiderate.RemoveAt(0);
            }
            else if(pointToConsiderate.Count &gt; 1 &amp;&amp; Math.Abs(((int) pointToConsiderate.ElementAt(1).Item3) - ((int) nextElm.Item3)) &gt; 1)
            {
              pointToConsiderate.RemoveAt(0);
            }
          }
        }
        else if(pointToConsiderate.Count == 2)
        {
          pointToConsiderate = pointToConsiderate.OrderBy(elm =&gt; elm.Item3).ToList();
          tmpTuple = pointToConsiderate.ElementAt(1);
          pointList.Insert((int) (tmpTuple.Item3 + 1), tmpTuple.Item2);
          if(!tmpTuple.Item1.Equals(tmpTuple.Item2))
          {
            pointList.Insert((int) (tmpTuple.Item3 + 1), tmpTuple.Item1);
          }
          int idxToRemove = (int) (tmpTuple.Item3);
          tmpTuple = pointToConsiderate.ElementAt(0);
          pointList.RemoveRange((int) (tmpTuple.Item3 + 1), idxToRemove - (int) (tmpTuple.Item3));
          if(!pointList.ElementAt((int) tmpTuple.Item3).Equals(tmpTuple.Item1))
          {
            pointList.Insert((int) (tmpTuple.Item3 + 1), tmpTuple.Item1);
          }
          if(!tmpTuple.Item1.Equals(tmpTuple.Item2))
          {
            pointList.Insert((int) (tmpTuple.Item3 + 1), tmpTuple.Item2);
          }
          pointList = pointList.Distinct().ToList();
          pointList.Add(Pos[i]);
          viewArea = new Polyline(pointList);
          viewAreaCurve = viewArea.ToPolylineCurve();
        }
        //Print("sekot " + iSect.Count);

      }
      objectInViewField.Add(Rhino.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(Rhino.RhinoDoc.ActiveDoc.Views.ActiveView.ActiveViewport, viewArea, true, Rhino.DocObjects.ObjectType.InstanceReference).ToList());//.Where(elm =&gt; elm.Attributes.LayerIndex == 98).ToList();
    }
    objectInView = objectInViewField;


    DateTime t2 = DateTime.Now;
    TimeSpan ts = t2 - t1;
    Print("tossua " + ts.TotalMilliseconds);
    //foreach(Point3d pph in pointList)
    //{
    //Print("polit " + pph);
    //}
    //Print("cudat "+DateTime.UtcNow);
    //pointList.
    //ro.
    //RhinoObject[] allWall = Rhino.RhinoDoc.ActiveDoc.Objects.FindByLayer("ARS-DINDING");
    //Rhino.RhinoApp.WriteLine("asu");
    //Print("kampret");
    //for(int i = 0;i &lt; ro.Length;i++)
    //for(int i = 0;i &lt; ro.Count();i++)
    //{
    //Rhino.RhinoApp.WriteLine("ojek " + ro[i]);
    //Console.WriteLine("ojek " + ro[i]);
    //Print("ojek " + ro[i].Id+" "+ro[i].Attributes.LayerIndex);
    //Print("ojek " + ro.ElementAt(i).Id);
    //}</item>
                    <item name="UsingSource" type_name="gh_string" type_code="10">using Rhino.DocObjects;
using System.Linq;</item>
