            <chunk name="Object" index="14">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="11">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
from Rhino.Geometry import Point3d, Vector3d,Point3f,Vector3f
import random


class MyComponent(component):
    initiated = None
    myPos = None
    speed = 1
    destination = None
    counter = 0
    
    moveDir = None
    destReached = None
    
    curWaitFrame = None
    initialX = 0
    initialY = 0
    initialZ = 0
    
    def __init__(self):
        self.initiated = False
        self.myPos = Point3f(0,0,0)
        self.destination = Point3f(0,0,0)
        self.moveDir = Vector3f(0,0,0)
        self.destReached = True
        self.curWaitFrame = 0
        self.initialX = 0
        self.initialY = 0
        self.initialZ = 0
    
    def RunScript(self, initial, active, x, id):
        a = None
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "andri.setiawan"
        __version__ = "2020.03.13"
        
        import rhinoscriptsyntax as rs
        import scriptcontext as sc
        
        print id
        #initialP = rs.coerce3dpoint(id)
        rh.RhinoDoc.ActiveDoc.Objects.Hide(id, True)
        #print initialP
        if (not self.initiated) or (active):
            if not self.initiated:
                #print initialP
                self.initialX = initial.X
                self.initialY = initial.Y
                self.initialZ = initial.Z
                self.initiated = True
                #rs.DeleteObject(initial)
            #print ("counter %d in %s r %s" %(self.counter,self.initiated,active))
            self.counter+=1
            self.myPos.X = self.initialX
            self.myPos.Y = self.initialY
            self.myPos.Z = self.initialZ
            self.destReached = True
        else:
            if self.destReached:
                if self.curWaitFrame &lt; 20:
                    self.curWaitFrame += 1
                else:
                    self.curWaitFrame = 0
                    self.makeNewDestination()
                    print ("new destination %d %d %d "%(self.destination.X,self.destination.Y,self.destination.Y))
            else:
                distance = self.myPos.DistanceTo(self.destination)
                if distance &gt; 1:
                    self.myPos = rs.PointAdd(self.myPos,self.moveDir)
                else:
                    self.myPos = self.destination
                    self.destReached  = True
        print ("pn %d %d %d %d" %(self.myPos.X,self.myPos.Y,self.myPos.Z,x))
        print ("modir %d %d %d %d" %(self.moveDir.X,self.moveDir.Y,self.moveDir.Z,x))
        print ("destination %d %d %d "%(self.destination.X,self.destination.Y,self.destination.Y))
                        
                        
                
        a = self.myPos
        #initialP.X = self.myPos.X
        #initialP.Y = self.myPos.Y
        #initialP.Z = self.myPos.Z
        
        # return outputs if you have them; here I try it for you:
        return a

    def makeNewDestination(self):
        from Rhino.Geometry import Point3d, Vector3d,Point3f,Vector3f
        import random
        self.destination = Point3f(random.randint(-100,100),random.randint(-100,100),random.randint(-100,100))
        
        self.moveDir = Vector3f.Subtract(Vector3f(self.destination.X,self.destination.Y,self.destination.Z),Vector3f(self.myPos.X,self.myPos.Y,self.myPos.Z))
        #length = Vector3d.Divide(
        self.moveDir = Vector3f.Divide(self.moveDir,self.moveDir.Length)
        self.destReached = False
</item>
