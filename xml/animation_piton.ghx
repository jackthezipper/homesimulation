                  <items count="11">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
from Rhino.Geometry import Rectangle3d

class MyComponent(component):
    def __init__(self):
        self.m_area = []
        self.m_mapName = ""
    
    def RunScript(self, ):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.09.29"
        
        import rhinoscriptsyntax as rs
        if len(self.m_area) == 0:
            obj = rh.RhinoDoc.ActiveDoc.Objects.FindByLayer("AREA_LIMIT")
            self.m_area = [None] * len(obj)
            print(len(obj))
            for ob in obj:
                pl = ob.Geometry.ToPolyline()
                rect = Rectangle3d(rh.Geometry.Plane.WorldXY,pl[0],pl[2])
                floor = int(rs.GetUserText(ob,"AreaLimit"))
                self.m_area[floor] = rect
                self.m_mapName = rs.GetUserText(ob,"MapName")
        # return outputs if you have them; here I try it for you:
        print(self.m_mapName)
        return self.m_area,self.m_mapName
