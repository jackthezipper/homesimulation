                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs
import Rhino.UI
import Eto.Drawing as drawing
import Eto.Forms as forms

import sys
cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)
    
import Agent
Agent = reload(Agent)
import Global
import Common


class ActivityViewer(forms.Form):
    def __init__(self):
        self.m_agentList = None
        self.Title = "Agent Activity"
        self.Padding = drawing.Padding(10)
        
        self.layout = forms.DynamicLayout()
        self.layout.Spacing = drawing.Size(5,5)
        self.layout.Padding = drawing.Padding(10)
        nLabel = forms.Label()
        
        self.layout.AddRow(nLabel)
        
        self.Content = self.layout
        
    def SetAgent(self, agentList):
        self.m_agentList = agentList
    
    def SetupLayout(self):
        self.m_timeText = forms.Label(Text = "Day "+str(Global.g_timer.GetDay())+" at "+Global.g_timer.GetFormattedHour())
        self.layout.AddRow(self.m_timeText)
        self.m_agentText = []
        for agent in self.m_agentList:
            agentText = agent.m_role + " : "
            if agent.m_currentActivity != None:
                agentText += agent.m_currentActivity.m_ID+" - "+agent.m_currentActivity.m_description
            else:
                agentText += "No Activity"
            textLabel = forms.Label(Text = agentText)
            self.layout.AddRow(textLabel)
            self.m_agentText.append(textLabel)
        header = ["Resource", "Last Usage", "Last User", "Device", "User Activity", "Total"]
        self.m_resGrid = forms.GridView()
        for i in range(len(header)):
            column = forms.GridColumn()
            column.HeaderText = header[i]
            column.DataCell = forms.TextBoxCell(i)
            self.m_resGrid.Columns.Add(column)
            self.m_resGrid.Columns[i].Visible = True
        
        data = []
        res = [["Electricity", Common.ENERGY_TYPE_ELECTRICITY], ["Water", Common.ENERGY_TYPE_WATER], ["Gas", Common.ENERGY_TYPE_GAS]]
        for resArr in res:
            rowData = [resArr[0]]
            hData = Global.g_myHouse.GetLastUsage(resArr[1])
            rowData.extend(hData)
            data.append(rowData)
        self.m_resGrid.DataStore = data
        self.layout.AddRow(self.m_resGrid)
        self.Content = self.layout
        
    def UpdateForm(self):
        self.m_timeText.Text = "Day "+str(Global.g_timer.GetDay())+" at "+Global.g_timer.GetFormattedHour()
        for i in range(0, len(self.m_agentText)):
            agentText = self.m_agentList[i].m_role + " : "
            if self.m_agentList[i].m_currentActivity != None:
                agentText += self.m_agentList[i].m_currentActivity.m_ID+" - "+self.m_agentList[i].m_currentActivity.m_description
            else:
                agentText += "No Activity"
            self.m_agentText[i].Text = agentText
        res = [["Electricity", Common.ENERGY_TYPE_ELECTRICITY], ["Water", Common.ENERGY_TYPE_WATER], ["Gas", Common.ENERGY_TYPE_GAS]]
        data = []
        for resArr in res:
            rowData = [resArr[0]]
            hData = Global.g_myHouse.GetLastUsage(resArr[1])
            rowData.extend(hData)
            data.append(rowData)
        self.m_resGrid.DataStore = data
    
class MyComponent(component):
    def __init__(self):
        self.m_formCreated = False
        self.m_formShown = False
        self.m_form = None
    
    def RunScript(self, agent, reset):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        if reset:
            self.m_formCreated = False
            self.m_formShown = False
            if self.m_form != None:
                self.m_form.Close()
                self.m_form = None
            return None
        
        print str(self.m_formCreated)+" "+str(self.m_formShown)
        if not self.m_formCreated:
            self.m_form = ActivityViewer()
            self.m_form.SetAgent(agent)
            self.m_form.SetupLayout()
            self.m_form.UpdateForm()
            self.m_form.Show()
            self.m_formShown = True
            self.m_formCreated = True
        
        if self.m_formShown:
            self.m_form.UpdateForm()
        
        __author__ = "LENOVO"
        __version__ = "2022.06.07"
        
        import rhinoscriptsyntax as rs
        a = 0
        
        # return outputs if you have them; here I try it for you:
        return a
