                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    if(!reset){
      c++;
    }else{
      c = -1;
    }
    c = (int) (c % (201));


    deltaTime = c;
    if(!reset)
    {
      state = 1;
    }
    else
    {
      state = 0;
    }
    if(oldTime == DateTime.MinValue)
    {
      deltaTime = 0;
    }
    else
    {
      deltaTime = (DateTime.Now - oldTime).TotalMilliseconds;
    }
    oldTime = DateTime.Now;
</item>
