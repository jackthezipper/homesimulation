              <chunks count="1">
                <chunk name="Container">
                  <items count="11">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
import scriptcontext as sc
import math
import Rhino.Geometry as rg
import sys
import Global
from Rhino.Geometry import Point3d,Point,NurbsSurface

cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)

import Target
Target = reload(Target)

import HomeObject
HomeObject = reload(HomeObject)

import Agent
Agent = reload(Agent)

import EntryPoint
EntryPoint = reload(EntryPoint)

import House
House = reload(House)

STATE_FREE = 0
STATE_BLOCKED = 1
STATE_ENTRY = 2
STATE_BLOCKED_OBJ = 3


class MyComponent(component):
    
    def __init__(self):
        self.NEIGHBOR_CHECK = []
        self.NEIGHBOR_DIS = 2
        self.WALL_DISTANCE = 0.15
        self.gridSize = 0.08
        self.grids = []
        self.gridInitialized = False
        self.topPos = []
        self.possibleTarget = []
        self.entryPoint = []
        self.isRun = False
        self.additionalWeight = []
        self.m_rooms = []
        self.polina = []
    
    def GenerateNeighborCheck(self):
        self.NEIGHBOR_CHECK = []
        for i in range(-self.NEIGHBOR_DIS,self.NEIGHBOR_DIS+1):
            for j in range(-self.NEIGHBOR_DIS,self.NEIGHBOR_DIS+1):
                if i == 0 and j == 0:
                    continue
                self.NEIGHBOR_CHECK.append((i,j))
    
    def GenerateRooms(self,objectList,idx):
        sc.doc = rh.RhinoDoc.ActiveDoc
        roomIndex = sc.doc.Layers.Find("ROOM_AREA",True)
        sc.doc = ghdoc
        for oi in objectList:
            if oi.Attributes.LayerIndex == roomIndex:
                pos = rs.GetUserText(oi,"TargetCoord").split(",")
                self.m_rooms.append(House.Room(rs.GetUserText(oi,"RName"),27,100,Point3d(float(pos[0]),float(pos[1]),0),oi.Geometry,idx))
        
    def InitializeGrid(self,area,idx):
        print "intinialisazuuuu "+str(idx)
        import rhinoscriptsyntax as rs
        self.GenerateNeighborCheck()
        
        sc.doc = rh.RhinoDoc.ActiveDoc
        groundIndex = sc.doc.Layers.Find("ARS-LANTAI",True)
        sc.doc = ghdoc
        
        entryPointObject = []
        targetPointObject = []
        
        self.polina = []
        #get nurbscurve or rectangle
        rectArea = rs.coercecurve(area)
        
        minX = min(rectArea.Points[0].Location[0],rectArea.Points[2].Location[0])
        maxX = max(rectArea.Points[0].Location[0],rectArea.Points[2].Location[0])
        
        minY = min(rectArea.Points[0].Location[1],rectArea.Points[2].Location[1])
        maxY = max(rectArea.Points[0].Location[1],rectArea.Points[2].Location[1])
        
        #get width/height of the area and gridCount
        gridCountW = abs(int(math.ceil(maxX/self.gridSize)) - int(math.floor(minX/self.gridSize)))
        
        gridCountH = abs(int(math.ceil(maxY/self.gridSize)) - int(math.floor(minY/self.gridSize)))
        
        #initialize grid array
        curGrids = [[STATE_FREE for i in range(gridCountH)]for j in range(gridCountW)]
        curAdditionalWeight = [[0 for i in range(gridCountH)]for j in range(gridCountW)]
        curTargets = []
        curEntries = []
        
        gridStartX = float(math.floor(minX/self.gridSize)) * self.gridSize
        gridStartY = float(math.ceil(maxY/self.gridSize)) * self.gridSize
        
        if rectArea:
            rh.DocObjects.Tables.ObjectTable.UnselectAll(rh.RhinoDoc.ActiveDoc.Objects)
            #get objects inside the region
            rc,pl = rectArea.TryGetPolyline()
            view = sc.doc.Views.ActiveView.ActiveViewport
            objectList = rh.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,pl,True,rh.DocObjects.ObjectType.AnyObject)#rh.DocObjects.ObjectType.Curve|rh.DocObjects.ObjectType.Point|rh.DocObjects.ObjectType.InstanceDefinition)
            
            for oi in objectList:
                if oi.Attributes.LayerIndex == groundIndex or rs.GetUserText(oi,"IgnoreGrid") != None:
                    continue
                
                if oi.ObjectType == rh.DocObjects.ObjectType.Point:
                    if rs.GetUserText(oi,"Target") != None:
                        target = Target.Target(idx,oi.PointGeometry.Location,rs.GetUserText(oi,"ID"))
                        targetPointObject.append(oi)
                        specific = rs.GetUserText(oi,"Specific")
                        if specific != None:
                            specList = specific.split(',')
                            for spec in specList:
                                target.setSpecificAgent(int(spec))
                        activity = rs.GetUserText(oi,"Activity")
                        if activity != None:
                            actList = activity.split(',')
                            for act in actList:
                                target.setActivity(act)
                        curTargets.append(target)
                    if rs.GetUserText(oi,"Entry") != None:
                        entryPointObject.append(oi)
                        curEntries.append(EntryPoint.EntryPoint(oi.PointGeometry.Location,idx))
                    continue
                    
                #print oi.GetType()
                if oi.GetType() == rh.DocObjects.InstanceObject:
                    bbox = oi.Geometry.GetBoundingBox(rh.Geometry.Plane.WorldXY)
                elif oi.GetType() == rh.DocObjects.CurveObject:
                    curve = oi.CurveGeometry
                    if not curve:
                        continue
                    bbox = curve.GetBoundingBox(True)
                else:
                    continue
                if not bbox.IsValid: continue
                
                xMin = int(((float(math.floor((bbox.Min.X - self.WALL_DISTANCE)/self.gridSize)) * self.gridSize) - gridStartX)/self.gridSize)
                xMax = int(((float(math.ceil((bbox.Max.X + self.WALL_DISTANCE)/self.gridSize)) * self.gridSize) - gridStartX)/self.gridSize)
                yMin = int((gridStartY - (float(math.floor((bbox.Min.Y - self.WALL_DISTANCE)/self.gridSize)) * self.gridSize))/self.gridSize)
                yMax = int((gridStartY - (float(math.ceil((bbox.Max.Y + self.WALL_DISTANCE)/self.gridSize)) * self.gridSize))/self.gridSize)
            
                for i in range(yMax,yMin+1):
                    for j in range(xMin,xMax+1):
                        if i &gt;= gridCountH or j &gt;= gridCountW or i &lt; 0 or j &lt; 0:
                            continue
                        cRect = rh.Geometry.Rectangle3d(rh.Geometry.Plane.WorldXY,rg.Point3d(gridStartX+(j*self.gridSize),gridStartY-(i*self.gridSize),0),rg.Point3d(gridStartX+((j+1)*self.gridSize),gridStartY-((i+1)*self.gridSize),0))
                        if oi.GetType() == rh.DocObjects.InstanceObject:
                            curGrids[j][i] = STATE_BLOCKED
                            #self.polina.append(cRect)
                        else:
                            inter = rg.Intersect.Intersection.CurveCurve(oi.CurveGeometry,cRect.ToNurbsCurve(),self.WALL_DISTANCE,0)
                            if inter:
                                curGrids[j][i] = STATE_BLOCKED
                                #self.polina.append(cRect)
            
            self.GenerateRooms(objectList,idx)
            
        #make way for entry
        for (epObject,ep) in zip(entryPointObject,curEntries):
            gridEpX = int(math.floor((ep.pos.X - gridStartX)/self.gridSize))
            gridEpY = int(math.floor((gridStartY - ep.pos.Y)/self.gridSize))
            
            curGrids[gridEpX][gridEpY] = STATE_ENTRY
            epGroupList = epObject.GetGroupList()
            dir = rs.GetUserText(epObject,"Direction")
            checker = 5
            if dir == "LEFT":
                for i in range(-1,-checker,-1):
                    if curGrids[gridEpX + i][gridEpY] == STATE_BLOCKED:
                        curGrids[gridEpX + i][gridEpY] = STATE_FREE
                    elif curGrids[gridEpX + i][gridEpY] == STATE_FREE:
                        break
            elif dir == "RIGHT":
                for i in range(1,checker):
                    if curGrids[gridEpX + i][gridEpY] == STATE_BLOCKED:
                        curGrids[gridEpX + i][gridEpY] = STATE_FREE
                    elif curGrids[gridEpX + i][gridEpY] == STATE_FREE:
                        break
            elif dir == "UP":
                for i in range(-1,-checker,-1):
                    if curGrids[gridEpX][gridEpY + i] == STATE_BLOCKED:
                        curGrids[gridEpX][gridEpY + i] = STATE_FREE
                    elif curGrids[gridEpX][gridEpY + i] == STATE_FREE:
                        break
            elif dir == "DOWN":
                for i in range(1,checker):
                    if curGrids[gridEpX][gridEpY + i] == STATE_BLOCKED:
                        curGrids[gridEpX][gridEpY + i] = STATE_FREE
                    elif curGrids[gridEpX][gridEpY + i] == STATE_FREE:
                        break
            for (tObject,target) in zip(targetPointObject,curTargets):
                #entrypoint and targetpoint is similar
                if epObject.Geometry.Location == tObject.Geometry.Location:
                    ep.target = target
                    break
                    
                #entrypoint different with targetpoint
                targetGroupList = tObject.GetGroupList()
                counter = 0
                #target and entry point must have all their group similar
                if targetGroupList == None or epGroupList == None:
                    continue
                for tGroup in targetGroupList:
                    for eGroup in epGroupList:
                        if tGroup == eGroup:
                            counter +=1
                            break
                if counter == len(targetGroupList):
                    ep.target = target
                    break
        
        #calculate additional weight, to make agent not walk to close with object or wall
        for i in range(len(curGrids[0])):
            for j in range(len(curGrids)):
                for neighbor in self.NEIGHBOR_CHECK:
                    toCheckX = i + neighbor[0]
                    toCheckY = j + neighbor[1]
                    
                    #out of area
                    if (toCheckX &lt; 0) or (toCheckX &gt;= gridCountH) or (toCheckY &lt; 0) or (toCheckY &gt;= gridCountW):
                        continue
                    
                    #wall
                    if curGrids[j][i] == STATE_BLOCKED:
                        continue
                    
                    if curGrids[toCheckY][toCheckX] == STATE_BLOCKED:
                        curAdditionalWeight[j][i] = max(curAdditionalWeight[j][i],(self.NEIGHBOR_DIS - max(abs(neighbor[0]),abs(neighbor[1])) + 1) * self.gridSize * 100)
                    
        sc.doc = rh.RhinoDoc.ActiveDoc
        furnitureIndex = sc.doc.Layers.Find("ARS-FURNITURE",True)
        sc.doc = ghdoc
        #Rhino.DocObjects.ObjectType.InstanceReference
        #homeFurniture = [object for object in objectList if (object.ObjectType != rh.DocObjects.ObjectType.Point and object.Attributes.LayerIndex == furnitureIndex)]
        homeFurniture = [object for object in objectList if (object.ObjectType == rh.DocObjects.ObjectType.InstanceReference and object.Attributes.LayerIndex == furnitureIndex)]
        print "homik "+str(len(homeFurniture))
        #honca = 
        homeObjects = []
        homeGroupList = []
        for hf in homeFurniture:
            index = 0
            hfGroup = hf.GetGroupList()
            haveSame = False
            if hfGroup != None:
                for (idx,gList) in enumerate(homeGroupList):
                    if gList != None:
                        haveSame = any(item in hfGroup for item in gList)
                        if haveSame:
                            index = idx
                            break
            if haveSame:
                homeObjects[index].AddParts(hf)
                homeGroupList[index] += hfGroup
                homeGroupList[index] = list(set(homeGroupList[index]))
            else:
                hObject = HomeObject.HomeObject()
                hObject.AddParts(hf)
                homeObjects.append(hObject)
                homeGroupList.append(hfGroup)
        
        for (tObject,target) in zip(targetPointObject,curTargets):
            targetGroupList = tObject.GetGroupList()
            if targetGroupList == None:
                continue
            for (hfGroup,hObject) in zip(homeGroupList,homeObjects):
                if hfGroup == None:
                    continue
                haveSame = any(item in targetGroupList for item in hfGroup)
                if haveSame:
                    hObject.AddTargetPoint(target)
                
        HomeObject.HomeObject.HomeObjectList = homeObjects
        self.gridInitialized = True
            
        self.topPos.append(Point3d(gridStartX,gridStartY,0))
        self.grids.append(curGrids)
        self.additionalWeight.append(curAdditionalWeight)
        self.possibleTarget = self.possibleTarget + curTargets
        self.entryPoint = self.entryPoint + curEntries
        
    def RunScript(self, area,counter,reset):
        print "asaw"
        gridArea = None
        topPos = None
        entryPoints = None
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "andri.setiawan"
        __version__ = "2020.03.16"
        
        
        import rhinoscriptsyntax as rs
        import sys
        
        if reset:
            self.gridInitialized = False
            self.isRun = False
            return None,None,None
        
        if (not self.isRun) and (not reset):
            self.isRun = True
            self.grids = []
            self.gridInitialized = False
            self.topPos = []
            self.possibleTarget = []
            self.entryPoint = []
            
        print self.gridInitialized
        if not self.gridInitialized:
            for (idx,floor) in enumerate(area):
                self.InitializeGrid(floor,idx)
            for target in self.possibleTarget:
                print "torogenta "+str(target.m_targetPoint)+" "+str(target.m_floorIndex)

        gridArea = self.grids
        topPos = self.topPos
        possibleTarget = self.possibleTarget
        entryPoints = self.entryPoint
        additionalWeight = self.additionalWeight
        
        
        #print "maze"
        #for i in range(len(self.grids[0][0])):
            #s = ""
            #for j in range(len(self.grids[0])):
                #s+=(str(self.grids[0][j][len(self.grids[0][0]) - i -1])+" ")
            #print s
        #print "weight"
        #for i in range(len(self.grids[0])):
            #s = ""
            #for j in range(len(self.grids)):
                #s+=(str(int(self.additionalWeight[j][len(self.additionalWeight[0]) - i -1]/10))+" ")
            #print s
    
        Global.g_myHouse.m_rooms = self.m_rooms
        
        return gridArea,topPos,possibleTarget,entryPoints,additionalWeight,self.m_rooms,None#self.polina
</item>
