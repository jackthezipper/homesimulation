                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
import scriptcontext as sc
import math
import csv
import Rhino.Geometry as rg
import sys

from Rhino.Geometry import Point3d,Point,NurbsSurface

cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)

import Global
Global = reload(Global)
import Target
Target = reload(Target)

import Agent
Agent = reload(Agent)

import EntryPoint
EntryPoint = reload(EntryPoint)

import House
House = reload(House)

import Door
Door = reload(Door)
DIRECTION_CCW = -1
DIRECTION_CW = 1
OFFSET = 0.01

import PathFinding
PathFinding = reload(PathFinding)

import Timer
import Config
Timer = reload(Timer)

STATE_FREE = 0
STATE_BLOCKED = 1
STATE_ENTRY = 2
STATE_BLOCKED_OBJ = 3


class MyComponent(component):
    
    def __init__(self):
        self.NEIGHBOR_CHECK = []
        self.NEIGHBOR_DIS = 2
        self.WALL_DISTANCE = 0.12
        self.gridSize = 0.08
        self.grids = []
        self.gridInitialized = False
        self.topPos = []
        self.possibleTarget = []
        self.entryPoint = []
        self.isRun = False
        self.additionalWeight = []
        self.m_rooms = []
        self.m_doors = []
    
    def GenerateNeighborCheck(self):
        self.NEIGHBOR_CHECK = []
        for i in range(-self.NEIGHBOR_DIS,self.NEIGHBOR_DIS+1):
            for j in range(-self.NEIGHBOR_DIS,self.NEIGHBOR_DIS+1):
                if i == 0 and j == 0:
                    continue
                self.NEIGHBOR_CHECK.append((i,j))
    
    def GenerateRooms(self,objectList,idx):
        sc.doc = rh.RhinoDoc.ActiveDoc
        roomIndex = sc.doc.Layers.Find("ROOM_AREA",True)
        sc.doc = ghdoc
        newRoom = []
        roomCoord = []
        roomCoordGroup = []
        roomGroup = []
        for object in objectList:
            if object.Attributes.LayerIndex == roomIndex:
                if object.GetType() == rh.DocObjects.PointObject:
                    roomCoord.append(object.PointGeometry.Location)
                    roomCoordGroup.append(object.GetGroupList())
                elif object.GetType() == rh.DocObjects.CurveObject:
                    newRoom.append(House.Room(rs.GetUserText(object,"RName"),27,100,object.Geometry,rs.GetUserText(object,"Lamp"), rs.GetUserText(object,"Resource"),idx))
                    rh.Geometry.PointContainment.Inside
                    roomGroup.append(object.GetGroupList())
        Global.Logger.LogDebug("G count "+str(len(roomCoord))+" "+str(len(roomCoordGroup))+"\n")
        i = 0;
        for (coord,rCGroup) in zip(roomCoord,roomCoordGroup):
            Global.Logger.LogDebug("iterate "+str(i))
            i+=1
            paired = False
            Global.Logger.LogDebug("Room coord "+str(coord)+" group "+str(rCGroup)+"\n")
            for g in rCGroup:
                for (room,rGroup) in zip(newRoom,roomGroup):
                    Global.Logger.LogDebug("Room "+room.m_name+" group "+str(rGroup)+"\n")
                    if rGroup == None:
                        continue
                    for rg in rGroup:
                        if g == rg:
                            room.AddTargetCoord(coord)
                            paired = True
                            break
                    if paired:
                        break
                if paired:
                    break
            Global.Logger.LogDebug("end loop\n")
        self.m_rooms.extend(newRoom)
        self.LoadLightAndTemperatureTable()
        Global.Logger.DumpDebug()
    def InitializeGrid(self,area,idx):
        print "InitializeGrid "+str(idx)
        import rhinoscriptsyntax as rs
        self.GenerateNeighborCheck()
        
        sc.doc = rh.RhinoDoc.ActiveDoc
        groundIndex = sc.doc.Layers.Find("ARS-LANTAI",True)
        sc.doc = ghdoc
        
        entryPointObject = []
        targetPointObject = []
        
        #get nurbscurve or rectangle
        rectArea = rs.coercecurve(area)
        
        minX = min(rectArea.Points[0].Location[0],rectArea.Points[2].Location[0])
        maxX = max(rectArea.Points[0].Location[0],rectArea.Points[2].Location[0])
        
        minY = min(rectArea.Points[0].Location[1],rectArea.Points[2].Location[1])
        maxY = max(rectArea.Points[0].Location[1],rectArea.Points[2].Location[1])
        
        #get width/height of the area and gridCount
        gridCountW = abs(int(math.ceil(maxX/self.gridSize)) - int(math.floor(minX/self.gridSize)))
        
        gridCountH = abs(int(math.ceil(maxY/self.gridSize)) - int(math.floor(minY/self.gridSize)))
        
        #initialize grid array
        curGrids = [[STATE_FREE for i in range(gridCountH)]for j in range(gridCountW)]
        curAdditionalWeight = [[0 for i in range(gridCountH)]for j in range(gridCountW)]
        curTargets = []
        curEntries = []
        
        gridStartX = float(math.floor(minX/self.gridSize)) * self.gridSize
        gridStartY = float(math.ceil(maxY/self.gridSize)) * self.gridSize
        
        if rectArea:
            rh.DocObjects.Tables.ObjectTable.UnselectAll(rh.RhinoDoc.ActiveDoc.Objects)
            #get objects inside the region
            rc,pl = rectArea.TryGetPolyline()
            view = sc.doc.Views.ActiveView.ActiveViewport
            objectList = rh.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,pl,True,rh.DocObjects.ObjectType.AnyObject)#rh.DocObjects.ObjectType.Curve|rh.DocObjects.ObjectType.Point|rh.DocObjects.ObjectType.InstanceDefinition)
            
            doorFrame = {}
            doorPanel = {}
            
            for object in objectList:
                if rs.GetUserText(object,"Type") == "Door":
                    part = rs.GetUserText(object,"Part")
                    id = rs.GetUserText(object, "ID")
                    if part == "Panel":
                        if id in doorPanel.keys():
                            doorPanel[id].append(object)
                        else:
                            doorPanel[id] = [object]
                    elif part == "Frame":
                         if id in doorFrame.keys():
                            doorFrame[id].append(object)
                         else:
                            doorFrame[id] = [object]
                    continue
                
                if object.Attributes.LayerIndex == groundIndex or rs.GetUserText(object,"IgnoreGrid") != None:
                    continue
                
                if object.ObjectType == rh.DocObjects.ObjectType.Point:
                    if rs.GetUserText(object,"Target") != None:
                        type = rs.GetUserText(object,"Type")
                        if type == None:
                            type = "Other"
                        usage = rs.GetUserText(object,"Usage")
                        pUsage = 0 if usage == None else float(usage)
                        active = rs.GetUserText(object,"Active") != None
                        envEffect = rs.GetUserText(object,"EnvEffect")
                        if envEffect == None:
                            envEffect = "-"
                        autoTrigger = rs.GetUserText(object,"Trigger")
                        if autoTrigger == None:
                            autoTrigger = "-"
                        target = Target.Target(idx,type,envEffect,object.PointGeometry.Location,rs.GetUserText(object,"ID"),pUsage, active,autoTrigger)
                        targetPointObject.append(object)
                        specific = rs.GetUserText(object,"Specific")
                        if specific != None:
                            specList = specific.split(',')
                            for spec in specList:
                                target.setSpecificAgent(int(spec))
                        activity = rs.GetUserText(object,"Activity")
                        if activity != None:
                            actList = activity.split(',')
                            for act in actList:
                                target.setActivity(act)
                        curTargets.append(target)
                    if rs.GetUserText(object,"Entry") != None:
                        entryPointObject.append(object)
                        curEntries.append(EntryPoint.EntryPoint(object.PointGeometry.Location,idx))
                    continue
                    
                if object.GetType() == rh.DocObjects.InstanceObject:
                    Global.Logger.LogDebug("geo type "+str(object.Geometry.GetType())+"\n")
                    bbox = object.Geometry.GetBoundingBox(rh.Geometry.Plane.WorldXY)
                    sc.doc = rh.RhinoDoc.ActiveDoc
                    new = rs.CopyObject(object.Id)
                    blockInstanceElements = rs.ExplodeBlockInstance(new,True)
                    curveBlockInstanceElements = []
                    for elm in blockInstanceElements:
                        cv = rs.coercecurve(elm)
                        if cv != None:
                            curveBlockInstanceElements.append(cv)
                    sc.doc=ghdoc
                    Global.Logger.DumpDebug()
                elif object.GetType() == rh.DocObjects.CurveObject:
                    curve = object.CurveGeometry
                    if not curve:
                        continue
                    bbox = curve.GetBoundingBox(True)
                else:
                    continue
                if not bbox.IsValid: continue
                
                xMin = int(((float(math.floor((bbox.Min.X - self.WALL_DISTANCE)/self.gridSize)) * self.gridSize) - gridStartX)/self.gridSize)
                xMax = int(((float(math.ceil((bbox.Max.X + self.WALL_DISTANCE)/self.gridSize)) * self.gridSize) - gridStartX)/self.gridSize)
                yMin = int((gridStartY - (float(math.floor((bbox.Min.Y - self.WALL_DISTANCE)/self.gridSize)) * self.gridSize))/self.gridSize)
                yMax = int((gridStartY - (float(math.ceil((bbox.Max.Y + self.WALL_DISTANCE)/self.gridSize)) * self.gridSize))/self.gridSize)
            
                for i in range(yMax,yMin+1):
                    for j in range(xMin,xMax+1):
                        if i &gt;= gridCountH or j &gt;= gridCountW or i &lt; 0 or j &lt; 0:
                            continue
                        cRect = rh.Geometry.Rectangle3d(rh.Geometry.Plane.WorldXY,rg.Point3d(gridStartX+(j*self.gridSize),gridStartY-(i*self.gridSize),0),rg.Point3d(gridStartX+((j+1)*self.gridSize),gridStartY-((i+1)*self.gridSize),0))
                        if object.GetType() == rh.DocObjects.InstanceObject:
                            for elm in curveBlockInstanceElements:
                                inter = rg.Intersect.Intersection.CurveCurve(elm,cRect.ToNurbsCurve(),self.WALL_DISTANCE,0)
                                if inter:
                                    curGrids[j][i] = STATE_BLOCKED
                        else:
                            inter = rg.Intersect.Intersection.CurveCurve(object.CurveGeometry,cRect.ToNurbsCurve(),self.WALL_DISTANCE,0)
                            if inter:
                                curGrids[j][i] = STATE_BLOCKED
                if object.GetType() == rh.DocObjects.InstanceObject:
                    sc.doc = rh.RhinoDoc.ActiveDoc
                    rs.DeleteObjects(blockInstanceElements)
                    sc.doc=ghdoc
            
            self.GenerateRooms(objectList,idx)
            Global.Logger.LogDebug("doorframe\n"+str(doorFrame)+"\n")
            Global.Logger.LogDebug("doorpanel\n"+str(doorPanel)+"\n")
            for doorFrameId in doorFrame.keys():
                if doorFrameId in doorPanel.keys():
                    frameBoundingBox = rh.Geometry.BoundingBox.Union(doorFrame[doorFrameId][0].Geometry.GetBoundingBox(True),doorFrame[doorFrameId][1].Geometry.GetBoundingBox(True))
                    panels = []
                    for panel in doorPanel[doorFrameId]:
                        rotCenter, rotDir = self.DetermineRotationCenterAndDir(frameBoundingBox,panel)
                        panelTuple = (panel, rotCenter, rotDir)
                        panels.append(panelTuple)
                    
                    frameCorner = frameBoundingBox.GetCorners()
                    
                    isVertical = (frameCorner[2].X - frameCorner[0].X &lt; frameCorner[2].Y - frameCorner[0].Y)
                    frameRect = rh.Geometry.Rectangle3d(rh.Geometry.Plane.WorldXY, frameCorner[0], frameCorner[2]).ToNurbsCurve()
                    door = Door.Door(panels, frameRect, rs.GetUserText(doorFrame[doorFrameId][0],"Room"))
                    self.m_doors.append(door)
            
        #make way for entry
        for (epObject,ep) in zip(entryPointObject,curEntries):
            gridEpX = int(math.floor((ep.pos.X - gridStartX)/self.gridSize))
            gridEpY = int(math.floor((gridStartY - ep.pos.Y)/self.gridSize))
            
            curGrids[gridEpX][gridEpY] = STATE_ENTRY
            epGroupList = epObject.GetGroupList()
            dir = rs.GetUserText(epObject,"Direction")
            checker = 5
            if dir == "LEFT":
                for i in range(-1,-checker,-1):
                    if curGrids[gridEpX + i][gridEpY] == STATE_BLOCKED:
                        curGrids[gridEpX + i][gridEpY] = STATE_FREE
                    elif curGrids[gridEpX + i][gridEpY] == STATE_FREE:
                        break
            elif dir == "RIGHT":
                for i in range(1,checker):
                    if curGrids[gridEpX + i][gridEpY] == STATE_BLOCKED:
                        curGrids[gridEpX + i][gridEpY] = STATE_FREE
                    elif curGrids[gridEpX + i][gridEpY] == STATE_FREE:
                        break
            elif dir == "UP":
                for i in range(-1,-checker,-1):
                    if curGrids[gridEpX][gridEpY + i] == STATE_BLOCKED:
                        curGrids[gridEpX][gridEpY + i] = STATE_FREE
                    elif curGrids[gridEpX][gridEpY + i] == STATE_FREE:
                        break
            elif dir == "DOWN":
                for i in range(1,checker):
                    if curGrids[gridEpX][gridEpY + i] == STATE_BLOCKED:
                        curGrids[gridEpX][gridEpY + i] = STATE_FREE
                    elif curGrids[gridEpX][gridEpY + i] == STATE_FREE:
                        break
            for (tObject,target) in zip(targetPointObject,curTargets):
                #entrypoint and targetpoint is similar
                if epObject.Geometry.Location == tObject.Geometry.Location:
                    ep.target = target
                    break
                    
                #entrypoint different with targetpoint
                targetGroupList = tObject.GetGroupList()
                counter = 0
                #target and entry point must have all their group similar
                if targetGroupList == None or epGroupList == None:
                    continue
                for tGroup in targetGroupList:
                    for eGroup in epGroupList:
                        if tGroup == eGroup:
                            counter +=1
                            break
                if counter == len(targetGroupList):
                    ep.target = target
                    break
        
        #calculate additional weight, to make agent not walk to close with object or wall
        for i in range(len(curGrids[0])):
            for j in range(len(curGrids)):
                for neighbor in self.NEIGHBOR_CHECK:
                    toCheckX = i + neighbor[0]
                    toCheckY = j + neighbor[1]
                    
                    #out of area
                    if (toCheckX &lt; 0) or (toCheckX &gt;= gridCountH) or (toCheckY &lt; 0) or (toCheckY &gt;= gridCountW):
                        continue
                    
                    #wall
                    if curGrids[j][i] == STATE_BLOCKED:
                        continue
                    
                    if curGrids[toCheckY][toCheckX] == STATE_BLOCKED:
                        curAdditionalWeight[j][i] = max(curAdditionalWeight[j][i],(self.NEIGHBOR_DIS - max(abs(neighbor[0]),abs(neighbor[1])) + 1) * self.gridSize * 100)
        
        for (tObject,target) in zip(targetPointObject,curTargets):
            targetGroupList = tObject.GetGroupList()
            for room in self.m_rooms:
                if room.CheckAndAddItem(target):
                    break
            if targetGroupList == None:
                continue
                
        entryToRemove = []
        for entry in curEntries:
            print entry.pos
            if entry.target != None:
                print entry.target.m_id
            ids = entry.target.m_id.split(";")
            if len(ids) &gt; 1:
                for id in ids:
                    nTarget = entry.target.CreateCopyForId(id)
                    nEntry = entry.CreateCopyForTarget(nTarget)
                    curEntries.append(nEntry)
                    curTargets.append(nTarget)
                entryToRemove.append(entry)
        for entry in entryToRemove:
            curTargets.remove(entry.target)
            curEntries.remove(entry)
        
        self.gridInitialized = True
            
        self.topPos.append(Point3d(gridStartX,gridStartY,0))
        Global.Logger.LogDebug("Grids\n")
        for i in range(len(curGrids[0])):
            s = ""
            for j in range(len(curGrids)):
                s += (str(curGrids[j][i])+" ")
            Global.Logger.LogDebug(s+"\n")
        Global.Logger.DumpDebug(10)
        self.grids.append(curGrids)
        self.additionalWeight.append(curAdditionalWeight)
        self.possibleTarget = self.possibleTarget + curTargets
        self.entryPoint = self.entryPoint + curEntries
        Global.g_myHouse.m_rooms = self.m_rooms
        Global.Logger.DumpDebug()
        
    def LoadLightAndTemperatureTable(self):
        Global.Logger.LogDebug("Load temperature\n")
        tableLight = {}
        tableTemperature = {}
        
        cFPath = ghenv.Component.OnPingDocument().FilePath
        cpath = cFPath[0:cFPath.rfind('\\')+1]
        resPath = cpath+'..\\res\\'+self.m_mapName+'\\'
        
        lightFile = resPath+Config.ROOM_LIGHT_FILE
        
        with open(lightFile) as csvfile:
            reader = csv.reader(csvfile)
            columnTable = []
            for row in reader:
                if row[0] == "Day":
                    for i in range(2,len(row)):
                        columnTable.append(row[i])
                        tableLight[row[i]] = []
                else:
                    for i in range(2,len(row)):
                        tableLight[columnTable[i-2]].append(float(row[i]))
        
        temperatureFile = resPath+Config.ROOM_TEMPERATURE_FILE
        with open(temperatureFile) as csvfile:
            reader = csv.reader(csvfile)
            columnTable = []
            for row in reader:
                if row[0] == "Day":
                    for i in range(2,len(row)):
                        columnTable.append(row[i])
                        tableTemperature[row[i]] = []
                else:
                    for i in range(2,len(row)):
                        tableTemperature[columnTable[i-2]].append(float(row[i]))
        
        Global.Logger.LogDebug("table light "+str(tableLight.keys())+"\n")
        Global.Logger.DumpDebug(10)
        for room in self.m_rooms:
            usedLightTable = []
            if room.m_name in tableLight.keys():
                usedLightTable = tableLight[room.m_name]
            usedTableTemperature = []
            if room.m_name in tableTemperature.keys():
                usedTableTemperature = tableTemperature[room.m_name]
            room.SetLightAndTemperatureTable(usedLightTable, usedTableTemperature)
        
    def DetermineRotationCenterAndDir(self, frameBox, panel):
        panelBox = panel.Geometry.GetBoundingBox(True)
        panelCenter = panelBox.Center
        
        frameCenter = frameBox.Center
        
        panelCorner = panelBox.GetCorners()
        isPanelVertical = (panelCorner[2].X - panelCorner[0].X &lt; panelCorner[2].Y - panelCorner[0].Y)
        index = 0
        direction = DIRECTION_CCW
        if isPanelVertical:
            if frameCenter.X &gt; panelCenter.X:
                if frameCenter.Y &gt; panelCenter.Y:
                    index = 3
                else:
                    index = 0
                    direction = DIRECTION_CW
            else:
                if frameCenter.Y &gt; panelCenter.Y:
                    index = 2
                    direction = DIRECTION_CW
                else:
                    index = 1
        else:
            if frameCenter.X &gt; panelCenter.X:
                if frameCenter.Y &gt; panelCenter.Y:
                    index = 1
                    direction = DIRECTION_CW
                else:
                    index = 2
            else:
                if frameCenter.Y &gt; panelCenter.Y:
                    index = 0
                else:
                    index = 3
                    direction = DIRECTION_CW
        rotationCenter = panelCorner[index]
        
        if isPanelVertical:
            if index == 0 or index == 3:
                rotationCenter.X += OFFSET
            else:
                rotationCenter.X -= OFFSET
        else:
            if index == 0 or index == 1:
                rotationCenter.Y += OFFSET
            else:
                rotationCenter.Y -= OFFSET
        return rotationCenter, direction
        
    def RunScript(self,reset, area, mapName):
        self.m_mapName = mapName
        gridArea = None
        topPos = None
        entryPoints = None
       
        
        __author__ = "andri.setiawan"
        __version__ = "2020.03.16"
        
        import rhinoscriptsyntax as rs
        import sys
        
        print reset
        if reset:
            self.gridInitialized = False
            self.isRun = False
            return None,None,None
        
        if (not self.isRun) and (not reset):
            self.isRun = True
            self.grids = []
            self.gridInitialized = False
            self.topPos = []
            self.possibleTarget = []
            self.entryPoint = []
            
        if not self.gridInitialized:
            self.m_mapName = mapName
            self.m_rooms = []
            Global.Logger.LogDebug("init\n")
            PathFinding.Map.actualRect = []
            for (idx,floor) in enumerate(area):
                Global.Logger.LogDebug("init "+str(idx)+" "+str(floor)+"\n")
                self.InitializeGrid(floor,idx)
                curveFloor = rs.coercecurve(floor)
                PathFinding.Map.actualRect.append(curveFloor)
            PathFinding.Map.InitNode()
            for target in self.possibleTarget:
                Global.Logger.LogDebug( "target floor "+str(target.m_targetPoint)+" "+str(target.m_floorIndex) +"\n")
            Global.Logger.DumpDebug()
            sc.sticky["PossibleTarget"] = self.possibleTarget
            sc.sticky["EntryPoint"] = self.entryPoint
            Global.g_myHouse.m_doors = self.m_doors

        gridArea = self.grids
        topPos = self.topPos
        additionalWeight = self.additionalWeight
        
        return gridArea,topPos,additionalWeight,self.m_rooms
        return None, None, None, None
