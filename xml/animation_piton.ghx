                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs
import sys
import math
import time
import scriptcontext as sc
from Rhino.Geometry import Surface,Plane,NurbsSurface,Point3d,Vector3d

cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)

import Agent
Agent = reload(Agent)

class MyComponent(component):
    def __init__(self):
        #cFPath = ghenv.Component.OnPingDocument().FilePath
        #cpath = cFPath[0:cFPath.rfind('\\')+1]
        #self.imgPath = []
        #self.imgPath.append(cpath+'..\\res\\m5.png')
        #self.imgPath.append(cpath+'..\\res\\w1.png')
        #self.imgPath.append(cpath+'..\\res\\m6.png')
        self.m_imgPath = []
        self.m_imgPath.append(cpath+'..\\res\\m5.png')
        self.m_imgPath.append(cpath+'..\\res\\w3.png')
        self.m_imgPath.append(cpath+'..\\res\\m4.png')
        self.m_imgPath.append(cpath+'..\\res\\w2.png')
        self.m_imgPath.append(cpath+'..\\res\\m2.png')
        self.m_imgPath.append(cpath+'..\\res\\w1.png')
        self.m_imgPath.append(cpath+'..\\res\\m6.png')
        self.m_imgPath.append(cpath+'..\\res\\w4.png')
        
    def RunScript(self,agents, location,angle):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "andri.setiawan"
        __version__ = "2020.05.11"
        
        import rhinoscriptsyntax as rs
        surfaces = []
        imgPath = []
        halfSize = 0.2
        #print location
        for i,agent in enumerate(agents):
            if (agent != None) and (agent.m_active):
                sf = NurbsSurface.CreateFromCorners(Point3d(agent.pos.X - halfSize,agent.pos.Y-halfSize,0),Point3d(agent.pos.X+halfSize,agent.pos.Y-halfSize,0),Point3d(agent.pos.X+halfSize,agent.pos.Y+halfSize,0),Point3d(agent.pos.X - halfSize,agent.pos.Y+halfSize,0))
                angle = math.atan2(agent.moveDir.Y,agent.moveDir.X) - math.atan2(-1,0)
                sf.Rotate(angle,Vector3d(0,0,1),agent.pos)
                surfaces.append(sf)
                imgPath.append(self.m_imgPath[i])
        #for (loc,agl) in zip(location,angle):
            #if loc != None:
                #sf = NurbsSurface.CreateFromCorners(Point3d(loc.X - halfSize,loc.Y-halfSize,0),Point3d(loc.X+halfSize,loc.Y-halfSize,0),Point3d(loc.X+halfSize,loc.Y+halfSize,0),Point3d(loc.X - halfSize,loc.Y+halfSize,0))
                #sf.Rotate(agl,Vector3d(0,0,1),loc)
                #surfaces.append(sf)
        # return outputs if you have them; here I try it for you:
        timeRS2 = int(time.time()* 1000)
        print str(timeRS2 - sc.sticky["StartFrame"])
        return surfaces,imgPath
