                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    if(!reset){
      c++;
    }else{
      c = -1;
    }
    c = (int) (c % (201));
    if(c &lt;= 200){
      B = true;
    }else{
      B = false;
    }


    C = c;
    if(!reset)
    {
      state = 1;
    }
    else
    {
      state = 0;
    }
</item>
