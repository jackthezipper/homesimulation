                    <item name="ScriptSource" type_name="gh_string" type_code="10">    if(oldTime == DateTime.MinValue)
    {
      deltaTime = 0;
    }
    else
    {
      deltaTime = (DateTime.Now - oldTime).TotalMilliseconds;
    }
    oldTime = DateTime.Now;
</item>
