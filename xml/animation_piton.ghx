            <chunk name="Object" index="19">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="11">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs
import sys
from Rhino.Geometry import Point3d,Vector3f,Vector3d,Line,Polyline
import math
import scriptcontext as sc

import time

cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)

import Agent
Agent = reload(Agent)

import PathFinding
PathFinding = reload(PathFinding)

class MyComponent(component):
    def __init__(self):
        self.haveAgentList = False
        self.myAgent = None
        self.s = 0
        self.pointScreen = []
    
    def RunScript(self,checkAgent, anySelected,mArea, agent,topPos,possibleTarget,entryPoints,additionalWeight,boundArea,deltaTime, scaleSpeed):
        #timeRS1 = int(time.time()*1000)
        import Agent
        
        PathFinding.Map.topPos = topPos
        PathFinding.Map.additionalWeight = additionalWeight
        angle = []
        
        #there is no agent
        if not agent[0]:
            self.pointScreen = []
            self.myAgent = []
            PathFinding.Map.liveBlock = []
            return
        elif len(self.pointScreen) == 0:
            for i in range(len(agent)):
                point = Point3d(0,0,0)
                self.pointScreen.append(point)
                PathFinding.Map.liveBlock.append(((0,0),0))
        a = None
        Agent.Agent.s_scaleSpeed = scaleSpeed
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        if not self.myAgent:
            self.myAgent = agent
        PathFinding.Map.maze = mArea
        
        __author__ = "andri.setiawan"
        __version__ = "2020.03.21"
        
        import rhinoscriptsyntax as rs
        
        Agent.Agent.s_possibleTarget = possibleTarget
        Agent.Agent.s_entryPointList = entryPoints
        Agent.Agent.agentList = agent
        
        vectorDir = []
        floorList = []
        #print "aa "+str(deltaTime)
        for (i,agt) in enumerate(self.myAgent):            
            if not checkAgent:
                #print "ini "+str(i)
                pos = agt.update(deltaTime)
                print agt.m_active
                if agt.m_active:
                    print agt.waitTime
                    print agt.m_state
                    print agt.m_target
                #print "cc "+str(agt.waitTime)
                agt.setBoundArea(boundArea[agt.m_myFloorIndex])
                #self.UpdateViewAgent(agt)
            
                if len(PathFinding.Map.liveBlock) &lt;= i:
                    PathFinding.Map.liveBlock.append((Agent.TranslateToGridPos(pos,agt.m_myFloorIndex),agt.m_myFloorIndex))
                else:
                    PathFinding.Map.liveBlock[i] = (Agent.TranslateToGridPos(pos,agt.m_myFloorIndex),agt.m_myFloorIndex)
                self.pointScreen[i].X = pos.X
                self.pointScreen[i].Y = pos.Y
                self.pointScreen[i].Z = pos.Z
            
            angle.append(math.atan2(agt.moveDir.Y,agt.moveDir.X) - math.atan2(-1,0))
            vectorDir.append(agt.moveDir)
            floorList.append(agt.m_myFloorIndex)
            
        # return outputs if you have them; here I try it for you:
        a = self.pointScreen
        timeRS2 = int(time.time()*1000)
        print str(timeRS2 - sc.sticky["StartFrame"])
        return self.myAgent,a,angle,vectorDir,floorList
        
    def UpdateViewAgent(self,agent):
        t1 = int(time.time()*1000)
        curveBound = agent.curveBoundArea#rs.coercecurve(agent.boundArea)
        #rc,pl = curveBound.TryGetPolyline()
        
        diagL = agent.diagonalBound#Vector3d.Subtract(Vector3d(curveBound.Points[0].Location),Vector3d(curveBound.Points[2].Location)).Length
        
        #curveBound,diagL = agent.getBoundArea()
        
        vec1 = rs.VectorRotate(agent.moveDir,-60,(0,0,1))
        #vec1.Unitize()
        endl1 = Point3d.Add(agent.pos,(vec1*diagL))
        mLine1 = Line(agent.pos,endl1)
        
        vec2 = rs.VectorRotate(agent.moveDir,60,(0,0,1))
        #vec2.Unitize()
        endl2 = Point3d.Add(agent.pos,(vec2*diagL))
        mLine2 = Line(agent.pos,endl2)
        
        iSect1 = Rhino.Geometry.Intersect.Intersection.CurveCurve(curveBound,mLine1.ToNurbsCurve(),0,0)
        iSect2 = Rhino.Geometry.Intersect.Intersection.CurveCurve(curveBound,mLine2.ToNurbsCurve(),0,0)
        #print "line1 "+str(mLine1.From)+" "+str(mLine1.To)
        #print "line2 "+str(mLine2.From)+" "+str(mLine2.To)
        
        for inte in iSect1:
            point1 = inte.PointA
            
        for inte in iSect2:
            point2 = inte.PointA
            
        
        vpointList = []
        for poin in curveBound.Points:
            vect = Vector3d.Subtract(Vector3d(poin.Location),Vector3d(agent.pos))
            vect.Unitize()
            angle = math.degrees(math.atan2(vect.Y,vect.X)-math.atan2(vec1.Y,vec1.X))
            if angle &gt;= 0 and angle &lt;= 120:
                vpointList.append((vect,poin.Location))
        
        vpointList.sort(key = lambda x: math.degrees(math.atan2(x[0].Y,x[0].X)-math.atan2(vec1.Y,vec1.X)),reverse = True)
        
        #print vpointList
        pointList = []
        pointList.append(agent.pos)
        pointList.append(point2)
        for vpoint in vpointList:
            pointList.append(vpoint[1])
        pointList.append(point1)
        pointList.append(agent.pos)
        palo = Polyline(pointList)
        
        t2 = int(time.time()*1000)
        print "delta1 "+str(t2-t1)
        view = sc.doc.Views.ActiveView.ActiveViewport      
        agent.objectList = Rhino.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,palo,True,Rhino.DocObjects.ObjectType.InstanceReference)
        #print agent.objectList
        t3 = int(time.time()*1000)
        print "delta2 "+str(t3-t2)

def TranslateToGridPos(topPos,pos):
    gridX = int(math.ceil((pos.X - topPos.X)/0.1))
    gridY = int(math.ceil((topPos.Y - pos.Y)/0.1))
    return gridX,gridY</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
                    <item name="EditorLocation" type_name="gh_drawing_point" type_code="30">
                      <X>532</X>
