                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs
import sys
from Rhino.Geometry import NurbsSurface, Point3d
import scriptcontext as sc

import Rhino.UI
import Eto.Drawing as drawing
import Eto.Forms as forms

class AgentActivator(forms.Form):
    def __init__(self):
        cFPath = ghenv.Component.OnPingDocument().FilePath
        cpath = cFPath[0:cFPath.rfind('\\')+1]
        self.m_imgPath = []
        self.m_imgPath.append(cpath+'..\\res\\m5.png')
        self.m_imgPath.append(cpath+'..\\res\\w3.png')
        self.m_imgPath.append(cpath+'..\\res\\m2.png')
        self.m_imgPath.append(cpath+'..\\res\\w1.png')
        self.m_imgPath.append(cpath+'..\\res\\m4.png')
        self.m_imgPath.append(cpath+'..\\res\\w2.png')
        self.m_imgPath.append(cpath+'..\\res\\m6.png')
        self.m_imgPath.append(cpath+'..\\res\\w4.png')
        
        self.m_names = []
        self.m_names.append("Pak Rudi")
        self.m_names.append("Bu Rudi")
        self.m_names.append("Rian")
        self.m_names.append("Sita")
        self.m_names.append("Kek Ramli")
        self.m_names.append("Nek Ramli")
        self.m_names.append("Dede")
        self.m_names.append("Linda")
        
        self.m_ticks = []
        
        self.Title = "Choose Active Agent"
        self.Padding = drawing.Padding(10)
        
        self.m_layout = forms.DynamicLayout()
        self.m_layout.Spacing = drawing.Size(5,5)
        self.m_layout.Padding = drawing.Padding(10)
        
        for i in range(0,4):
            layout = forms.DynamicLayout()
            tick = forms.CheckBox()
            self.m_ticks.append(tick)
            personIcon = forms.ImageView()
            personIcon.Size = drawing.Size(50,50)
            personIcon.Image = drawing.Bitmap(self.m_imgPath[i*2])
            name = forms.Label(Text = self.m_names[i*2],HorizontalAlign = forms.HorizontalAlign.Center)
            layout.Spacing = drawing.Size(5,5)
            layout.Padding = drawing.Padding(10)
            layout.AddRow(tick,personIcon)
            layout.AddRow(None,name)
            
            layout2 = forms.DynamicLayout()
            tick = forms.CheckBox()
            self.m_ticks.append(tick)
            personIcon = forms.ImageView()
            personIcon.Size = drawing.Size(50,50)
            personIcon.Image = drawing.Bitmap(self.m_imgPath[(i*2)+1])
            name = forms.Label(Text = self.m_names[(i*2)+1],HorizontalAlign = forms.HorizontalAlign.Center)
            layout2.Spacing = drawing.Size(5,5)
            layout2.Padding = drawing.Padding(10)
            layout2.AddRow(tick,personIcon)
            layout2.AddRow(None,name)
            
            self.m_layout.AddRow(layout,layout2)
        self.DefaultButton = forms.Button(Text = 'OK')
        self.DefaultButton.Click += self.OnOKButtonClick
        self.m_layout.AddRow(self.DefaultButton)
        self.m_layout.AddSpace()
        self.m_shown = False
        self.Shown += self.Osho
        self.Closed += self.Oclo
        self.Content = self.m_layout
        
    def OnOKButtonClick(self, sender, e):
        self.Close()
    
    def Osho(self, sender, e):
        self.m_shown = True
        
    def Oclo (self, sender, e):
        self.m_shown = False
        sc.sticky["AgentActivationDone"] = True
        
    def AdjustAgentCount(self, amount):
        curShow = 0
        self.m_layout = forms.DynamicLayout()
        self.m_layout.Spacing = drawing.Size(5,5)
        self.m_layout.Padding = drawing.Padding(10)
        self.m_ticks = []
        for i in range(0,4):
            layout = None
            layout2 = None
            if curShow &lt; amount:
                layout = forms.DynamicLayout()
                tick = forms.CheckBox()
                self.m_ticks.append(tick)
                personIcon = forms.ImageView()
                personIcon.Size = drawing.Size(50,50)
                personIcon.Image = drawing.Bitmap(self.m_imgPath[i*2])
                name = forms.Label(Text = self.m_names[i*2],HorizontalAlign = forms.HorizontalAlign.Center)
                layout.Spacing = drawing.Size(5,5)
                layout.Padding = drawing.Padding(10)
                layout.AddRow(tick,personIcon)
                layout.AddRow(None,name)
            
            curShow+=1
            if curShow &lt; amount:            
                layout2 = forms.DynamicLayout()
                tick = forms.CheckBox()
                self.m_ticks.append(tick)
                personIcon = forms.ImageView()
                personIcon.Size = drawing.Size(50,50)
                personIcon.Image = drawing.Bitmap(self.m_imgPath[(i*2)+1])
                name = forms.Label(Text = self.m_names[(i*2)+1],HorizontalAlign = forms.HorizontalAlign.Center)
                layout2.Spacing = drawing.Size(5,5)
                layout2.Padding = drawing.Padding(10)
                layout2.AddRow(tick,personIcon)
                layout2.AddRow(None,name)
            curShow+=1
            self.m_layout.AddRow(layout,layout2)
        self.m_layout.AddRow(self.DefaultButton)
        self.m_layout.AddSpace()
        self.Content = self.m_layout
        print "ketik "+str(len(self.m_ticks))

class MyComponent(component):
    def __init__(self):
        self.m_activeAgent = [False for i in range(0,8)]
        self.m_hasSetup = False
        self.m_klow = False
        self.m_dialoh = AgentActivator()
        self.m_count = 0
        self.m_surfaces = []
        
    def RunScript(self, Locations, Reset, Frame, MapName):
        UsedLocation = None
        sc.sticky["MapName"] = MapName
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.07.27"
        if len(self.m_activeAgent) != len(Locations):
            self.m_hasSetup = False
        import rhinoscriptsyntax as rs
        print "omake "+str(Reset)+" "+str(self.m_hasSetup)
        if  (not Reset) and (not self.m_hasSetup):# and (not self.m_klow) :
            self.m_dialoh = AgentActivator()
            self.m_dialoh.m_names = []
            for loc in Locations:
                role = rs.GetUserText(loc,"Role")
                self.m_dialoh.m_names.append(role)
            for rul in self.m_dialoh.m_names:
                print rul
            self.m_dialoh.AdjustAgentCount(len(Locations))
            self.m_activeAgent = [False for i in range(0,len(Locations))]
            print "ajusting "+str(len(Locations))
            self.m_dialoh.Show()#Rhino.UI.RhinoEtoApp.MainWindow)
            self.m_hasSetup = True
            self.m_klow = True
            halfSize = 0.2
            print "ketot "+str(len(self.m_dialoh.m_ticks))
            for pLoc in Locations:
                if pLoc != None:
                    loc = pLoc.PointGeometry.Location
                    surface = NurbsSurface.CreateFromCorners(Point3d(loc.X - halfSize,loc.Y-halfSize,0),Point3d(loc.X+halfSize,loc.Y-halfSize,0),Point3d(loc.X+halfSize,loc.Y+halfSize,0),Point3d(loc.X - halfSize,loc.Y+halfSize,0))
                    self.m_surfaces.append(surface)
        elif Reset:
            print "respati"
            self.m_hasSetup = False
            self.m_count += 1
            if self.m_klow:
                self.m_dialoh.Close()
                self.m_klow
        #print self.m_dialoh.m_shown
        #print self.m_count
        #print self.m_activeAgent
        # return outputs if you have them; here I try it for you:
        retSurface = []
        retImg = []
        self.m_activeAgent = [tick.Checked for tick in self.m_dialoh.m_ticks]
        if self.m_dialoh.m_shown:
            print len(self.m_activeAgent)
            for i,isActive in enumerate(self.m_activeAgent):
                if isActive:
                    retSurface.append(self.m_surfaces[i])
                    retImg.append(self.m_dialoh.m_imgPath[i])
        
        return self.m_activeAgent,retSurface,retImg
