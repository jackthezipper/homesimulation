                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs
import scriptcontext as sc
from Rhino.Geometry import Plane,NurbsSurface,Point3d,Vector3d
import sys

cFPath = ghenv.Component.OnPingDocument().FilePath
print cFPath
cpath = cFPath[0:cFPath.rfind('\\')+1]
print cpath
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)

import Agent
Agent = reload(Agent)

class MyComponent(component):
    def __init__(self):
        self.isAgentBaked = False
        self.magel = []
        self.gugu = []
    
    def RunScript(self, checkAgent, agentList,location, angle):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "andri.setiawan"
        __version__ = "2020.05.12"
        
        import rhinoscriptsyntax as rs
        
        halfSize = 0.3
        fullSize = halfSize*2
        if checkAgent:
            if not self.isAgentBaked:
                
                sc.doc = Rhino.RhinoDoc.ActiveDoc
                for (loc,agl) in zip(location,angle):
                    #loc = agent.pos
                    sf = NurbsSurface.CreateFromCorners(Point3d(loc.X - fullSize,loc.Y-fullSize,0),Point3d(loc.X,loc.Y-fullSize,0),Point3d(loc.X,loc.Y,0),Point3d(loc.X - fullSize,loc.Y,0))
                    #sf = NurbsSurface.CreateFromCorners(Point3d(loc.X - halfSize,loc.Y-halfSize,0),Point3d(loc.X+halfSize,loc.Y-halfSize,0),Point3d(loc.X+halfSize,loc.Y+halfSize,0),Point3d(loc.X - halfSize,loc.Y+halfSize,0))
                    sf.Rotate(agl,Vector3d(0,0,1),loc)
                    print agl
                    self.magel.append(agl)
                    plane = None
                    rc,plane = sf.TryGetPlane(0)
                    #Rhino.RhinoDoc.ActiveDoc.Objects.AddPictureFrame(
                    #sc.doc.Objects.AddSurface(sf)
                    guid = sc.doc.Objects.AddPictureFrame(plane,"D:\Project\omae\walki.png",True,halfSize*2,halfSize*2,False,True)
                    rs.SetUserText(guid,"LiveAgent","--")
                    self.gugu.append(guid)
                self.isAgentBaked = True
                sc.doc = ghdoc
        else:
            if self.isAgentBaked:
                self.isAgentBaked = False
        for agl in self.magel:
            print agl
        for gu in self.gugu:
            print gu
        # return outputs if you have them; here I try it for you:
        return None
