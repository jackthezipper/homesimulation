        __author__ = "andri.setiawan"
        __version__ = "2020.03.16"
        
        
        import rhinoscriptsyntax as rs
        import sys
        
        if reset:
            self.gridInitialized = False
            self.isRun = False
            return None,None,None
        
        if (not self.isRun) and (not reset):
            self.isRun = True
            self.grids = None
            self.gridInitialized = False
            self.topPos = None
            self.possibleTarget = []
            self.entryPoint = []
            
        
        if not self.gridInitialized:
            self.InitializeGrid(area)
        
