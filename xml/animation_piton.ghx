                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs

from Rhino.DocObjects import BrepObject


import scriptcontext as sc
import Rhino as rh
        
import System
import Rhino.UI
import Eto.Drawing as drawing
import Eto.Forms as forms

import csv
        
maxAttributes = 0
#forms.DynamicLayout.AddSpace(
templates = []

class ObjectTemplate():
    def __init__(self,name):
        self.name = name
        self.attributes = []
        self.activities = []
        
    def AddAttribute(self,key,value):
        self.attributes.append((key,value))
    
    def AddActivity(self,key,value):
        self.activities.append((key,value))

class SelectTemplateDialog(forms.Dialog[bool]):
    def __init__(self,obj):
        self.object = obj
        self.Title = "Select Template"
        self.templateChoice = []
        self.Resizable = False
        self.Padding = drawing.Padding(10)
        for tmpl in templates:
            self.templateChoice.append(tmpl.name)
        self.rGroup = forms.RadioButtonList()
        self.rGroup.DataStore = self.templateChoice
        self.rGroup.Orientation = forms.Orientation.Vertical
        self.rGroup.SelectedIndex = 0
        self.rGroup.SelectedIndexChanged += self.UpdateAttribute
        self.layoutChoice = forms.DynamicLayout()
        self.layoutChoice.Spacing = drawing.Size(5, 5)
        self.layoutChoice.AddRow(self.rGroup)
        self.layoutChoice.Padding = drawing.Padding(10)
        self.layout = forms.DynamicLayout()
        self.layout.Spacing = drawing.Size(5, 5)
        self.layout.Padding = drawing.Padding(10)
        self.layoutAttribute = forms.DynamicLayout()
        self.layoutAttribute.Spacing = drawing.Size(5, 5)
        self.layoutAttribute.Padding = drawing.Padding(10)
        self.layoutAttribute.AddRow(forms.Label(Text = "Attributes"))
        self.layoutAttributeTextBox = []
        for attr in templates[self.rGroup.SelectedIndex].attributes:
            textBox = forms.TextBox(Text = attr[1])
            self.layoutAttribute.AddRow(forms.Label(Text = attr[0]),textBox)
            self.layoutAttributeTextBox.append(textBox)
        if len(templates[self.rGroup.SelectedIndex].attributes) &lt; maxAttributes:
            for i in range(len(templates[self.rGroup.SelectedIndex].attributes), maxAttributes):
                nLabel = forms.Label()
                #nLabel.Visible = False
                nText = forms.TextBox()
                self.layoutAttributeTextBox.append(nText)
                nText.Enabled = False
                self.layoutAttribute.AddRow(nLabel,nText)
        
        
        self.layoutActivity = forms.DynamicLayout()
        self.layoutActivity.Spacing = drawing.Size(5, 5)
        self.layoutActivity.Padding = drawing.Padding(10)
        self.layoutActivity.AddRow(forms.Label(Text = "Activity"))
        self.layoutActivityTextBox = []
        for act in templates[self.rGroup.SelectedIndex].activities:
            textBox = forms.TextBox(Text = act[1])
            self.layoutActivity.AddRow(forms.Label(Text = act[0]),textBox)
            self.layoutActivityTextBox.append(textBox)
        self.layoutActivity.AddSpace()
        
        #self.layoutAttribute.AddRow(None)
        self.layout.AddRow(self.layoutChoice,self.layoutAttribute,self.layoutActivity,self.layoutActivity)
        #cc = self.layoutAttribute.Children
        #print cc[0]
        #layout.AddColumn(layoutAttribute)
        # Create the default button
        self.DefaultButton = forms.Button(Text = 'Save')
        self.DefaultButton.Click += self.OnOKButtonClick
        
        # Create the abort button
        self.AbortButton = forms.Button(Text = 'Cancel')
        self.AbortButton.Click += self.OnCloseButtonClick
        buttonLayout = forms.DynamicLayout()
        
        buttonLayout.Spacing = drawing.Size(5, 5)
        buttonLayout.Padding = drawing.Padding(10)
        buttonLayout.AddRow(self.DefaultButton,self.AbortButton)
        self.layout.AddRow(None,buttonLayout)
        
        self.Content = self.layout
        
    def OnCloseButtonClick(self, sender, e):
        #self.m_textbox.Text = ""
        self.Close(False)
        
            # OK button click handler
    def OnOKButtonClick(self, sender, e):
        #if self.m_textbox.Text == "":
            #self.Close(False)
        #else:
        for obj in self.object:
            rs.SetUserText(obj,"ObjectType",templates[self.rGroup.SelectedIndex].name)
            print len(templates[self.rGroup.SelectedIndex].attributes)
            print len(self.layoutAttributeTextBox)
            for (attr,textBox) in zip(templates[self.rGroup.SelectedIndex].attributes,self.layoutAttributeTextBox):
                rs.SetUserText(obj,"Attribute."+attr[0],textBox.Text)
            for (act,textBox) in zip(templates[self.rGroup.SelectedIndex].activities,self.layoutActivityTextBox):
                rs.SetUserText(obj,"Activity."+act[0],textBox.Text)
        self.Close(True)
        
    def UpdateAttribute(self,sender,e):
        print "asooooooooooooooooo"
        #forms.DynamicLayout.Remove(
        layout = forms.DynamicLayout()
        layout.Spacing = drawing.Size(5, 5)
        layout.Padding = drawing.Padding(10)
        self.layoutAttribute = forms.DynamicLayout()
        self.layoutAttribute.Spacing = drawing.Size(5, 5)
        self.layoutAttribute.Padding = drawing.Padding(10)
        self.layoutAttribute.AddRow(forms.Label(Text = "Attributes"))
        self.layoutAttributeTextBox = []
        for attr in templates[self.rGroup.SelectedIndex].attributes:
            textBox = forms.TextBox(Text = attr[1])
            self.layoutAttribute.AddRow(forms.Label(Text = attr[0]),textBox)
            self.layoutAttributeTextBox.append(textBox)
        if len(templates[self.rGroup.SelectedIndex].attributes) &lt; maxAttributes:
            for i in range(len(templates[self.rGroup.SelectedIndex].attributes), maxAttributes):
                nLabel = forms.Label()
                #nLabel.Visible = False
                nText = forms.TextBox()
                self.layoutAttributeTextBox.append(nText)
                nText.Enabled = False
                self.layoutAttribute.AddRow(nLabel,nText)
        
        
        self.layoutActivity = forms.DynamicLayout()
        self.layoutActivity.Spacing = drawing.Size(5, 5)
        self.layoutActivity.Padding = drawing.Padding(10)
        self.layoutActivity.AddRow(forms.Label(Text = "Activity"))
        self.layoutActivityTextBox = []
        for act in templates[self.rGroup.SelectedIndex].activities:
            textBox = forms.TextBox(Text = act[1])
            self.layoutActivity.AddRow(forms.Label(Text = act[0]),textBox)
            self.layoutActivityTextBox.append(textBox)
        self.layoutActivity.AddSpace()
        
        layout.AddRow(self.layoutChoice,self.layoutAttribute,self.layoutActivity)
        print "assddd22"
        print self.layout.Size
        #self.Size.Height += 28
        print self.Size
        #drawing.Size.
        #layout.UpdateBindings()
        #forms.DynamicLayout.
        #layout.Invalidate(False)
        print str(layout.Height) + " "+str(layout.Width)
        buttonLayout = forms.DynamicLayout()
        
        buttonLayout.Spacing = drawing.Size(5, 5)
        buttonLayout.Padding = drawing.Padding(10)
        buttonLayout.AddRow(self.DefaultButton,self.AbortButton)
        layout.AddRow(None,buttonLayout)
        self.Content = layout
        self.layout = layout
        #self.Invalidate(False)
        #self.Initialize()
        #print "opeeeekkkk "+str(self.rGroup.SelectedIndex)
        #self.layoutAttribute.

class AttributeDialog(forms.Dialog[bool]):

    # Dialog box Class initializer
    def __init__(self,obj):
    # Initialize dialog box
        self.object = obj
        self.Title = 'Object Info'
        self.Padding = drawing.Padding(10)
        self.Resizable = False
 
        #keyStrings = rs.GetUserText(obj)

        self.keys = rs.GetUserText(obj[0])
        #self.m_attributeValues = []
        self.m_attributeLabels = []
        self.m_attributeTextboxes = []
        
        #self.m_activityValues = []
        self.m_activityLabels = []
        self.m_activityTextboxes = []

        # Create a table layout and add all the controls
        self.layout = forms.DynamicLayout()
        self.layout.Spacing = drawing.Size(5, 5)
        self.layoutAttribute = forms.DynamicLayout()
        self.layoutAttribute.Spacing = drawing.Size(5, 5)
        self.layoutActivity = forms.DynamicLayout()
        self.layoutActivity.Spacing = drawing.Size(5, 5)
        
        self.layoutAttribute.AddRow(forms.Label(Text = "Attribute:"))
        self.layoutActivity.AddRow(forms.Label(Text = "Activity:"))
        for (i,key) in enumerate(self.keys):
            if key == "ObjectType":
                self.layout.AddRow(forms.Label(Text = ("Object Type: " + rs.GetUserText(obj[0],key))))
            elif key.startswith("Attribute"):
                textBox = forms.TextBox(Text = rs.GetUserText(obj[0],key))
                label = forms.Label(Text = key[10:])
                self.layoutAttribute.AddRow(label,textBox)
                self.m_attributeLabels.append(label)
                self.m_attributeTextboxes.append(textBox)
            elif key.startswith("Activity"):
                textBox = forms.TextBox(Text = rs.GetUserText(obj[0],key))
                label = forms.Label(Text = key[9:])
                self.layoutActivity.AddRow(label,textBox)
                self.m_activityLabels.append(label)
                self.m_activityTextboxes.append(textBox)
                
        self.layoutAttribute.AddSpace()
        self.layoutActivity.AddSpace()
        self.layout.AddRow(self.layoutAttribute,self.layoutActivity)
        # Create the default button
        self.DefaultButton = forms.Button(Text = 'Save')
        self.DefaultButton.Click += self.OnOKButtonClick
        
        # Create the abort button
        self.AbortButton = forms.Button(Text = 'Cancel')
        self.AbortButton.Click += self.OnCloseButtonClick
        
        #for (label,text) in zip(self.m_labels,self.m_textboxes):
            #layout.AddRow(label, text)
        self.layout.AddRow(None) # spacer
        self.layout.AddRow(self.DefaultButton, self.AbortButton)
        
        # Set the dialog content
        self.Content = self.layout
    # Close button click handler
    def OnCloseButtonClick(self, sender, e):
        #self.m_textbox.Text = ""
        self.Close(False)
        
            # OK button click handler
    def OnOKButtonClick(self, sender, e):
        #if self.m_textbox.Text == "":
            #self.Close(False)
        #else:
        for obj in self.object:
            #rs.SetUserText(obj,"ObjectType",templates[self.rGroup.SelectedIndex].name)
            #print len(templates[self.rGroup.SelectedIndex].attributes)
            #print len(self.layoutAttributeTextBox)
            for (attr,textBox) in zip(self.m_attributeLabels,self.m_attributeTextboxes):
                rs.SetUserText(obj,"Attribute."+attr.Text,textBox.Text)
            for (act,textBox) in zip(self.m_activityLabels,self.m_activityTextboxes):
                rs.SetUserText(obj,"Activity."+act.Text,textBox.Text)
        self.Close(True)
        
class AgentPropertiesDialog(forms.Dialog[bool]):
    # Dialog box Class initializer
    def __init__(self,obj):
        self.object = obj
        self.Title = "Agent Properties"
        self.layout = forms.DynamicLayout()
        self.layout.Spacing = drawing.Size(5, 5)
        self.layout.Padding = drawing.Padding(10)
        self.layout.AddRow(forms.Label(Text = "There will be agent properties here"))
        self.layout.AddSpace()
        # Create the default button
        self.DefaultButton = forms.Button(Text = 'OK')
        self.DefaultButton.Click += self.OnOKButtonClick
        self.layout.AddRow(None,self.DefaultButton)
        
        self.Content = self.layout
        
    
    # OK button click handler
    def OnOKButtonClick(self, sender, e):
        #if self.m_textbox.Text == "":
            #self.Close(False)
        #else:
        self.Close(True)
        
class MyComponent(component):
    def __init__(self):
        self.selectedObject = None
        self.isAgentSelected = False
        #self.templates = []
    
    def LoadTemplateCSV(self,filename):
        if not filename:
            return
        with open(filename) as csvfile:
            reader = csv.reader(csvfile)
            newTemplate = False
            attributeSession = False
            activitySession = False
            curTemplate = None
            attributeCount = 0
            global maxAttributes
            for row in reader:
                if row[0] == "Object":
                    attributeCount = 0
                    curTemplate = ObjectTemplate(row[1])
                    newTemplate = True
                elif row[0] == "Type":
                    attributeSession = (row[1] == "Attributes")
                    activitySession = (row[1] == "Activity")
                elif row[0] == "EndObject":
                    newTemplate = False
                    attributeSession = False
                    activitySession = False
                    templates.append(curTemplate)
                    maxAttributes = max(maxAttributes,attributeCount)
                    #curTemplate = None
                elif attributeSession:
                    curTemplate.AddAttribute(row[0],row[1])
                    attributeCount += 1
                elif activitySession:
                    curTemplate.AddActivity(row[0],row[1])
                    
    def RunScript(self, counter,reset):
        if reset:
            return False
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "andri.setiawan"
        __version__ = "2020.05.03"
        anySelected = False
        if len(templates) == 0:
            cFPath = ghenv.Component.OnPingDocument().FilePath
            cpath = cFPath[0:cFPath.rfind('\\')+1]
            my_path = cpath+'..\\res\\templates.csv'
            self.LoadTemplateCSV(my_path)
            
            
        
        sc.doc = rh.RhinoDoc.ActiveDoc
        #rh.DocObjects.Tables.ObjectTable.
        objList = rh.DocObjects.Tables.ObjectTable.GetSelectedObjects(sc.doc.Objects,False,False)
        sc.doc=ghdoc
        
        #print objList
        firstObject = None
        
        objectSelection = []
        keepGroup = []
        keepObject = []
        for i,obj in enumerate(objList):
            if i == 0:
                firstObject = obj
                keepGroup = firstObject.Attributes.GetGroupList()
            #if i == 0:
                #firstObject = obj
                #usrData = rs.GetUserText(obj)
                #dialog = AttributeDialog(obj)
                #rc = dialog.ShowModal(Rhino.UI.RhinoEtoApp.MainWindow)
                #self.selectedObject = obj
            #break
            else:
                objectSelection.append(obj)
            
            
        keepObject.append(firstObject)
        
        if keepGroup != None and len(keepGroup) != 0:
            for groupId in keepGroup:
                for obj in objectSelection:
                    objGroup = obj.Attributes.GetGroupList()
                    if objGroup != None and groupId in objGroup:
                        keepObject.append(obj)
            
        if firstObject:
            if self.selectedObject != firstObject:
                userData = rs.GetUserText(firstObject)
                print "usera"
                print userData
                hasTemplateData = False
                if len(userData) &gt; 0:
                    hasTemplateData = ("ObjectType" in userData)
                #print hasTempla
                if hasTemplateData:
                    dialog = AttributeDialog(keepObject)
                elif ("LiveAgent" in userData):
                    dialog = AgentPropertiesDialog(firstObject)
                    self.isAgentSelected = True
                else:
                    dialog = SelectTemplateDialog(keepObject)
                rc = dialog.ShowModal(Rhino.UI.RhinoEtoApp.MainWindow)
                self.selectedObject = firstObject
        else:
            self.selectedObject = None
            self.isAgentSelected = False
        #Rhino.DocObjects.CurveObject.I
        if firstObject:
            rh.DocObjects.Tables.ObjectTable.UnselectAll(rh.RhinoDoc.ActiveDoc.Objects)
            #for obj in keepObject:
                #rh.DocObjects.Tables.ObjectTable.Select(rh.RhinoDoc.ActiveDoc.Objects,obj.Id,True,True)
        anySelected = (firstObject != None) and not self.isAgentSelected
        # return outputs if you have them; here I try it for you:
        return anySelected
