                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    if(!reset){
      c++;
    }else{
      c = -1;
    }
    c = (int)(c%(interval.Max + 1));
    if(c &gt;= interval.Min &amp;&amp; c &lt;= interval.Max){
      B = true;
    }else{
      B = false;
    }


    C = c;
</item>
