    def DetermineRotationCenterAndDir(self, frameBox, panel):
        panelBox = panel.Geometry.GetBoundingBox(True)
        panelCenter = panelBox.Center
        
        frameCenter = frameBox.Center
        
        panelCorner = panelBox.GetCorners()
        isPanelVertical = (panelCorner[2].X - panelCorner[0].X &lt; panelCorner[2].Y - panelCorner[0].Y)
        index = 0
        direction = DIRECTION_CCW
        if isPanelVertical:
            if frameCenter.X &gt; panelCenter.X:
                if frameCenter.Y &gt; panelCenter.Y:
                    index = 3
                else:
                    index = 0
                    direction = DIRECTION_CW
            else:
                if frameCenter.Y &gt; panelCenter.Y:
                    index = 2
                    direction = DIRECTION_CW
                else:
                    index = 1
        else:
            if frameCenter.X &gt; panelCenter.X:
                if frameCenter.Y &gt; panelCenter.Y:
                    index = 1
                    direction = DIRECTION_CW
                else:
                    index = 2
            else:
                if frameCenter.Y &gt; panelCenter.Y:
                    index = 0
                else:
                    index = 3
                    direction = DIRECTION_CW
        rotationCenter = panelCorner[index]
        
        if isPanelVertical:
            if index == 0 or index == 3:
                rotationCenter.X += OFFSET
            else:
                rotationCenter.X -= OFFSET
        else:
            if index == 0 or index == 1:
                rotationCenter.Y += OFFSET
            else:
                rotationCenter.Y -= OFFSET
        return rotationCenter, direction</item>
