                <chunk name="Container">
                  <items count="11">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
import scriptcontext as sc

class MyComponent(component):
    
    def RunScript(self,x):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.12.18"
        
        import rhinoscriptsyntax as rs
        rectArea = rs.coercecurve(x)
        rc,pl = rectArea.TryGetPolyline()
        #print rc
        #print pl
        view = sc.doc.Views.ActiveView.ActiveViewport
        objectList = rh.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,pl,True,rh.DocObjects.ObjectType.AnyObject)
        doorObject = []
        doorGroup = []
        
        doorPanelGroup = []
        doorPanelObject = []
        doorFrameGroup = []
        doorFrameObject = []
        #rh.Geometry.BoundingBox.Union.
        for oo in objectList:
            #print oo.Id
            #print rs.GetUserText(oo,"Type")
            if rs.GetUserText(oo,"Type") == "Door":
                groupList = oo.GetGroupList()
                print rs.GetUserText(oo,"Part")
                part = rs.GetUserText(oo,"Part")
                
                if part == "Door":
                    doorPanelObject.append(oo)
                    for group in groupList:
                        doorPanelGroup.append(group)
                else:
                    found = False
                    index = -1
                    for group in groupList:
                        for (idx,existGroup) in enumerate(doorFrameGroup):
                            for singleGroup in existGroup:
                                if group == singleGroup:
                                    found = True
                                    index = idx
                                    break
                    if not found:
                        doorFrameGroup.append(groupList)
                        doorFrameObject.append([oo])
                    else:
                        doorFrameObject[index].append(oo)
            
        for oi in doorPanelObject:
            print oi.Id
        
        print "frame"
        for ou in doorFrameObject:
            for kk in ou:
               print kk.Id
        # return outputs if you have them; here I try it for you:
        return None
