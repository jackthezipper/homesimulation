        #tok = rs.RotateObject(tesObj,centerRotation,90,Vector3d.ZAxis)
        #print tok
        #sc.doc = ghdoc
        #gai = rh.RhinoDoc.ActiveDoc.Objects.AddInstanceObject(tesObj.InstanceDefinition.Index,tesObj.Geometry.Xform)
        #print gai
        #rh.RhinoDoc.ActiveDoc.Objects.AddPoint(pClone.GetBoundingBox(True).Center)
