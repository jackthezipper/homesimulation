        #print tesObj.Geometry.Xform
        #print tesObj.Id
        #rs.RotateObject(
        #cero = rs.coerce3dpoint(centerRotation,True)
        #axu = rs.coerce3dvector(Vector3d.ZAxis,True)
        #xf = rh.Geometry.Transform.Rotation(math.radians(90), axu, cero)
        #print cero
        #print axu
