        #print "bego"
        #print tesObj.Geometry.GetBoundingBox(True).Center
        #tesObj.Geometry.Translate(1.0,0.0,0.0)
        #centerRotation = tesObj.Geometry.GetBoundingBox(True).GetCorners()[3]
        #print centerRotation
        #centerRotation.X += 0.01
        #print "lembu"
