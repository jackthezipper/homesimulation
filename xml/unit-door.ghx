                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
import scriptcontext as sc
import sys
from Rhino.Geometry import Point3d,Vector3d
import Rhino.DocObjects
import math

cFPath = ghenv.Component.OnPingDocument().FilePath
cpath = cFPath[0:cFPath.rfind('\\')+1]
my_path = cpath+'..\source'
if not my_path in sys.path:
    sys.path.append(my_path)

import Door
Door = reload(Door)
DIRECTION_CCW = -1
DIRECTION_CW = 1
OFFSET = 0.01
class MyComponent(component):
    
    def RunScript(self,x):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.12.18"
        sc.doc = ghdoc
        import rhinoscriptsyntax as rs
        print x
        rectArea = rs.coercecurve(x)
        print rectArea
        rc,pl = rectArea.TryGetPolyline()
        #print rc
        #print pl
        view = sc.doc.Views.ActiveView.ActiveViewport
        objectList = rh.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,pl,True,rh.DocObjects.ObjectType.AnyObject)
        doorObject = []
        doorGroup = []
        
        doorPanelGroup = []
        doorPanelObject = []
        doorFrameGroup = []
        doorFrameObject = []
        #rh.Geometry.BoundingBox.Union.
        for oo in objectList:
            #print oo.Id
            #print rs.GetUserText(oo,"Type")
            if rs.GetUserText(oo,"Type") == "Door":
                groupList = oo.GetGroupList()
                print rs.GetUserText(oo,"Part")
                part = rs.GetUserText(oo,"Part")
                
                if part == "Panel":
                    doorPanelObject.append(oo)
                    for group in groupList:
                        doorPanelGroup.append(group)
                else:
                    found = False
                    index = -1
                    for group in groupList:
                        for (idx,existGroup) in enumerate(doorFrameGroup):
                            for singleGroup in existGroup:
                                if group == singleGroup:
                                    found = True
                                    index = idx
                                    break
                    if not found:
                        doorFrameGroup.append(groupList)
                        doorFrameObject.append([oo])
                    else:
                        doorFrameObject[index].append(oo)
            
        tesObj = None
        for oi in doorPanelObject:
            print oi.GetType()
            print oi.Id
            tesObj = oi
        
        print "frame"
        for ou in doorFrameObject:
            for kk in ou:
               print kk.Id
        pClone = None
        #rh.Geometry.InstanceReferenceGeometry.GetBoundingBox(
        #rh.Geometry.BoundingBox.Center
        for (doorGroup,panelObj) in zip(doorPanelGroup,doorPanelObject):
            index = -1
            for (idx,frameGroups) in enumerate(doorFrameGroup):
                for group in frameGroups:
                    if doorGroup == group:
                        index = idx
                        break
                if index != -1:
                    break
            if index != -1:
                print panelObj.GetType()
                pClone = panelObj.DuplicateGeometry()
                print pClone.GetType()
                frameBoundingBox = rh.Geometry.BoundingBox.Union(doorFrameObject[index][0].Geometry.GetBoundingBox(True),doorFrameObject[index][1].Geometry.GetBoundingBox(True))
                rotCenter, rotDir = self.DetermineRotationCenterAndDir(frameBoundingBox,panelObj)
                doorObject.append(Door.Door(panelObj,frameBoundingBox,rotCenter,rotDir,Door.DOOR_OPEN))
        for do in doorObject:
            do.Close()
        # return outputs if you have them; here I try it for you:
        #rs.AddPoints(
        #pClone.Translate(1.0,0.0,0.0)
        #listClone = []
