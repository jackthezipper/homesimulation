                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
import scriptcontext as sc
import Rhino.Geometry
from Rhino.Geometry import Vector3d,Point3d,Line,Polyline
import math

class MyComponent(component):
    def __init__(self):
        self.pola = None
    
    def RunScript(self, x, y):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.05.19"
        
        import rhinoscriptsyntax as rs
        print x.GetType()
        rarea = rs.coercecurve(x)
        
        #Rhino.Geometry.NurbsCurve.Points
        #Rhino.Geometry.ControlPoint.Location
        print rarea.Points[0].Location
        #print pl
        rc,pl = rarea.TryGetPolyline()
        
        vecDir = Vector3d(0,1,0)
        diag = Vector3d.Subtract(Vector3d(rarea.Points[0].Location),Vector3d(rarea.Points[2].Location))
        length = diag.Length
        #print diag
        #print len
        print "abababababababa"
        vec1 = rs.VectorRotate(vecDir,-60,(0,0,1))
        endl1 = Point3d.Add(y,(vec1*length))
        mLine1 = Line(y,endl1)
        
        vec2 = rs.VectorRotate(vecDir,60,(0,0,1))
        endl2 = Point3d.Add(y,(vec2*length))
        mLine2 = Line(y,endl2)
        #Line.to
        iSect1 = Rhino.Geometry.Intersect.Intersection.CurveCurve(rarea,mLine1.ToNurbsCurve(),0,0)
        iSect2 = Rhino.Geometry.Intersect.Intersection.CurveCurve(rarea,mLine2.ToNurbsCurve(),0,0)
        
        for inte in iSect1:
            point1 = inte.PointA
            
        for inte in iSect2:
            point2 = inte.PointA
            
        print (mLine1.Direction/mLine1.Length)
        
        #print point1
        #print point2
        
        deg = math.degrees(math.atan2(vec1.Y,vec1.X)-math.atan2(vec2.Y,vec2.X))
        #print deg
        
        #Vector3d.Unitize(
        vpointList = []
        for poin in rarea.Points:
            vect = Vector3d.Subtract(Vector3d(poin.Location),Vector3d(y))
            vect.Unitize()
            angle = math.degrees(math.atan2(vect.Y,vect.X)-math.atan2(vec1.Y,vec1.X))
            if angle &gt;= 0 and angle &lt;= 120:
                vpointList.append((vect,poin.Location))
        #print vpointList
        
        vpointList.sort(key = lambda x: math.degrees(math.atan2(x[0].Y,x[0].X)-math.atan2(vec1.Y,vec1.X)),reverse = True)
        
        #print vpointList
        pointList = []
        pointList.append(y)
        pointList.append(point2)
        for vpoint in vpointList:
            pointList.append(vpoint[1])
        pointList.append(point1)
        pointList.append(y)
        
        #print pointList
        
        
        view = sc.doc.Views.ActiveView.ActiveViewport      
        objectList = rh.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,pointList,True,rh.DocObjects.ObjectType.Curve)
        
        sc.doc = rh.RhinoDoc.ActiveDoc
        layerIndex = sc.doc.Layers.Find("ARS_DINDING",True)
        sc.doc = ghdoc
        
        oriWallList = [item for item in objectList if item.Attributes.LayerIndex == layerIndex]
                
        mLine2.To = point2
        mLine1.To = point1
        
        #Rhino.Geometry.Curve(
        
        viewArea = Polyline(pointList)
        
        #print viewArea.Item
        #for i in viewArea.GetSegments():
            #print i#.GetType()
        
        viewAreaCurve = viewArea.ToNurbsCurve()
        wallList = []
        
        while len(oriWallList) &gt; 0:
            curWall = oriWallList.pop()
            #Rhino.DocObjects.CurveObject.
            iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve,curWall.Geometry,0,0)
            print curWall.Id
            #for sect in iSect:
                #print sect.PointA
                #print sect.PointB
            #print len(iSect)
            pointToConsiderate = []
            
            #intersection point
            for sect in iSect:
                pointC,posPoint = curWall.Geometry.ClosestPoint(sect.PointA,0)
                pointToConsiderate.append((sect.PointA,sect.PointA,posPoint))
                
            print "intersection point"
            for pot in pointToConsiderate:
                print pot[0]
                
            #viewAreaCurve = viewArea.ToNurbsCurve()
            #print "zzzzzzzzzzzzzzzzzzzzzz"
            #arpo = viewArea.ToArray()
            #for aa in arpo:
                #p,f = viewAreaCurve.ClosestPoint(aa,0)
                #print str(aa)+" "+str(p)+" "+str(f)
            #print "hhhhhhhhhhhhhhhhh"
            #for i in range(0,len(arpo)):
                #plo = viewAreaCurve.PointAt(i)
                #print str(i)+" "+str(plo)
                
            #print "eeeeeeeeeeeeeeeeeeeee"
            
            #point in wall inside view area + projection into view area
            #Rhino.Geometry.Curve.Contains(
            isPol,pointInCurve = curWall.Geometry.TryGetPolyline()
            #pointInCurve = pointInCurve[:-1]
            
            print "curve point"
            for po in pointInCurve:
                print po
            
            #pointInside = [p for p in pointInCurve if viewArea.Contains(p) == Rhino.Geometry.PointContainment.Inside]
            pointInside = []
            #print viewArea.GetType()
            #Rhino.Geometry.NurbsCurve.Contains(
            for p in pointInCurve:
                pointPos = viewAreaCurve.Contains(p)
                print "check "+str(p)+" "+str(pointPos)
                if pointPos == Rhino.Geometry.PointContainment.Inside:
                    vDir = Point3d.Subtract(p,y)
                    vDir.Unitize()
                    line = Line(y,vDir,length)
                
                    iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve,line.ToNurbsCurve(),0,0)
                    
                    for sect in iSect:
                        pointC,posPoint = curWall.Geometry.ClosestPoint(sect.PointA,0)
                        pointToConsiderate.append((p,sect.PointA,posPoint))
                    
            if len(pointToConsiderate) &gt; 2:
                pointToConsiderate.sort(key = lambda x: x[2])
                while len(pointToConsiderate) &gt; 1:
                    print len(pointToConsiderate)
                    curElm = pointToConsiderate.pop()
                    nextElm = pointToConsiderate[0]
                    newWall = Line(curElm[0],nextElm[0])
                    wallList.append(newWall.ToNurbsCurve())
                    
                    #at intersection
                    print nextElm
                    print nextElm[0]
                    print nextElm[1]
                    print nextElm[2]
                    e1 = nextElm[0]
                    e2 = nextElm[1]
                    if e1 == e2:
                        curElm = pointToConsiderate.pop()
                        
                    #different segment line
                    elif abs(int(pointToConsiderate[1][2]) - int(nextElm[2])) &gt; 1:
                        curElm = pointToConsiderate.pop()
            else:
                wallList.append(curWall.Geometry)
            #Rhino.Geometry.Curve.ClosestPoint(
            #pointToConsiderate.extend(pointInside)
            
            #projection of point inside curve
            #for p in pointInside:
                #vDir = Point3d.Subtract(p,y)
                #vDir.Unitize()
                #line = Line(y,vDir,length)
                
                #iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewArea.ToNurbsCurve(),line.ToNurbsCurve(),0,0)
                #for sect in iSect:
                   # pointToConsiderate.append(sect.PointA)
                
            
            
            
            #for p in pointToConsiderate:
                #print p
                
             
        
        
        
        #for wall in wallList:
            #print wall.Geometry.GetType()
            #Rhino.DocObjects.CurveObject.Geometry
            #iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(wall.Geometry,mLine2.ToNurbsCurve(),0,0)
            #for inte in iSect:
                
        
        
            #vect = vect/vect.Length
        #Rhino.Geometry.Intersect.IntersectionEvent.PointA
        
        #Rhino.Geometry.Intersect.CurveIntersections.Item
        #Rhino.Geometry.Line(
        #print iSect
        print "mmmmmmmmmmmmmmmm"
        for weol in wallList:
            print weol
        print "ccccccccccccccccc"
        self.pola = viewArea
        
        #Rhino.Geometry.NurbsCurve.ClosestPoint(
        
        #view = sc.doc.Views.ActiveView.ActiveViewport      
        #objectList = rh.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,pl,True,rh.DocObjects.ObjectType.Curve)
        #Vector3d.Rotate(
        #print objectList
        #for oi in objectList:
            #rg.Intersect.Intersection.CurveCurve(
            #rs.CurveCurveIntersection
            #print oi.Id
            #rs.CurveCurveIntersection(
            #iter = []
            #iter = rs.CurveCurveIntersection(oi.CurveGeometry,x,0)
            #p = []
            #iter(p)
            #if not iter:
                #continue
            #print iter
            #print p
            #for aa in iter:
                #print aa
            #print "bbbbbbbbbbb"
        # return outputs if you have them; here I try it for you:
        return self.pola
