    //for(int i = 0;i &lt; ro.Count();i++)
    //{
    //Rhino.RhinoApp.WriteLine("ojek " + ro[i]);
    //Console.WriteLine("ojek " + ro[i]);
    //Print("ojek " + ro[i].Id+" "+ro[i].Attributes.LayerIndex);
    //Print("ojek " + ro.ElementAt(i).Id);
    //}</item>
