            <chunk name="Object" index="4">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">a9a8ebd2-fff5-4c44-a8f5-739736d129ba</item>
                <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="11">
                    <item name="CustomUsing" type_name="gh_bool" type_code="1">true</item>
                    <item name="Description" type_name="gh_string" type_code="10">A C#.NET scriptable component</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>18</X>
                      <Y>13</Y>
                    </item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">ab6a9ab0-a61b-4220-8c8d-79c66fc3d987</item>
                    <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">C#</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">    //Rhino.RhinoDoc.ActiveDoc.Views.ActiveView
    Polyline pl = x.ToPolyline();
    Layer wallLayer = RhinoDoc.ActiveDoc.Layers.FindName("ARS_DINDING");
    List&lt;Rhino.DocObjects.RhinoObject&gt; wallList = Rhino.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(Rhino.RhinoDoc.ActiveDoc.Views.ActiveView.ActiveViewport, pl, true, Rhino.DocObjects.ObjectType.Curve).Where(elm =&gt; elm.Attributes.LayerIndex == 98).ToList();
    Print("ddo " + ((Rhino.DocObjects.CurveObject) wallList.ElementAt(0)).CurveGeometry.GetType());
    Rhino.DocObjects.RhinoObject j;
    List&lt;Rhino.Geometry.Curve&gt; wallListCurve = new List&lt;Rhino.Geometry.Curve&gt;();
    for(int i = wallList.Count() - 1;i &gt;= 0;i--)
    {
      wallListCurve.Insert(0, ((Rhino.DocObjects.CurveObject) wallList.ElementAt(i)).CurveGeometry);
    }

    //ro.
    //RhinoObject r;
    //r.
    DateTime t1 = DateTime.Now;
    Vector3d unitDir = new Vector3d(0, 1, 0);
    Vector3d myDir = new Vector3d(unitDir);
    //myDir.Rotate(RhinoMath.ToRadians(-90), Vector3d.ZAxis);
    Print("hombara " + pl.ElementAt(0));
    var diagL = Point3d.Subtract(pl.ElementAt(0), pl.ElementAt(2)).Length;
    Print("whale " + wallLayer + " " + wallList.Count() + " " + diagL);

    Vector3d tmp = new Vector3d(myDir);
    tmp.Rotate(RhinoMath.ToRadians(-60), Vector3d.ZAxis);
    Line l1 = new Line(y, tmp, diagL);

    tmp.Rotate(RhinoMath.ToRadians(120), Vector3d.ZAxis);
    Line l2 = new Line(y, tmp, diagL);

    tmp.Rotate(RhinoMath.ToRadians(-120), Vector3d.ZAxis);

    var iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(pl.ToPolylineCurve(), l1.ToNurbsCurve(), 0, 0);
    Point3d point1 = new Point3d(0, 0, 0);
    for(int i = 0;i &lt; iSect.Count;i++)
    {
      point1 = iSect.ElementAt(i).PointA;
      Print("puki " + point1);
    }
    //Print("puki " + point1);
    iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(pl.ToPolylineCurve(), l2.ToNurbsCurve(), 0, 0);
    Point3d point2 = new Point3d(0, 0, 0);
    for(int i = 0;i &lt; iSect.Count;i++)
    {
      point2 = iSect.ElementAt(i).PointA;
    }

    List&lt;Point3d&gt; pointList = new List&lt;Point3d&gt;();
    List&lt;Tuple&lt;Point3d,double&gt;&gt; vpointList = new List&lt;Tuple&lt;Point3d,double&gt;&gt;();
    for(int i = 0;i &lt; pl.Count - 1;i++)
    {
      Vector3d dir = Point3d.Subtract(pl.ElementAt(i), y);
      dir.Unitize();
      double angle = RhinoMath.ToDegrees(Math.Atan2(dir.Y, dir.X) - Math.Atan2(tmp.Y, tmp.X));
      //Print("elus " + angle);
      if(angle &gt;= 0 &amp;&amp; angle &lt;= 120)
      {
        vpointList.Add(Tuple.Create(pl.ElementAt(i), angle));
      }
      //pointList
    }
    Tuple&lt;int,int&gt; cc = Tuple.Create(3, 4);
    //Print("fff " + cc.Item1);
    vpointList = vpointList.OrderByDescending(elm =&gt; elm.Item2).ToList();
    pointList.Add(y);
    pointList.Add(point2);
    for(int i = 0;i &lt; vpointList.Count();i++)
    {
      pointList.Add(vpointList.ElementAt(i).Item1);
    }
    pointList.Add(point1);
    pointList.Add(y);

    Polyline viewArea = new Polyline(pointList);
    PolylineCurve viewAreaCurve = viewArea.ToPolylineCurve();

    List&lt;Rhino.Geometry.Curve&gt; checkWallList = new List&lt;Rhino.Geometry.Curve&gt;(wallListCurve);
    List&lt;Tuple&lt;Point3d,Point3d,double,double&gt;&gt; pointToConsiderate = new List&lt;Tuple&lt;Point3d,Point3d,double,double&gt;&gt;();

    Vector3d vDir = new Vector3d(tmp);
    Tuple&lt;Point3d,Point3d,double,double&gt; tmpTuple;
    while(checkWallList.Count() &gt; 0)
    {
      Rhino.Geometry.Curve curWall = checkWallList.ElementAt(0);
      checkWallList.RemoveAt(0);
      iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve, curWall, 0, 0);

      pointToConsiderate.Clear();
      foreach (Rhino.Geometry.Intersect.IntersectionEvent sect in iSect)
      {
        double posPointC;
        viewAreaCurve.ClosestPoint(sect.PointA, out posPointC);
        double posPointW;
        curWall.ClosestPoint(sect.PointA, out posPointW);
        double testPos = Math.Round(posPointW) - posPointW;
        if(Math.Abs(testPos) &gt; 0.05)
        {
          pointToConsiderate.Add(Tuple.Create(sect.PointA, sect.PointA, posPointC, posPointW));
        }
      }
      Polyline pll;
      curWall.TryGetPolyline(out pll);

      foreach(Point3d p in pll)
      {
        vDir = Point3d.Subtract(p, y);
        double angle = RhinoMath.ToDegrees(Vector3d.VectorAngle(vDir, myDir));
        if(angle &gt; 60)
        {
          continue;
        }
        Rhino.Geometry.PointContainment pointPos = viewAreaCurve.Contains(p);
        //Print("peplos " + pointPos);
        if(pointPos == Rhino.Geometry.PointContainment.Inside)
        {
          Line line = new Line(y, vDir, diagL);
          iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve, line.ToNurbsCurve(), 0, 0);
          foreach (Rhino.Geometry.Intersect.IntersectionEvent sect in iSect)
          {
            if(!sect.PointA.Equals(y))
            {
              double posPointC;
              viewAreaCurve.ClosestPoint(sect.PointA, out posPointC);
              double posPointW;
              curWall.ClosestPoint(p, out posPointW);
              //Print("penpendar ");
              pointToConsiderate.Add(Tuple.Create(p, sect.PointA, posPointC, posPointW));
              //Print("perotak "+pointToConsiderate.Count());
            }
          }
        }
        else if(pointPos == Rhino.Geometry.PointContainment.Coincident)
        {
          double posPointC;
          viewAreaCurve.ClosestPoint(p, out posPointC);
          double posPointW;
          curWall.ClosestPoint(p, out posPointW);
          pointToConsiderate.Add(Tuple.Create(p, p, posPointC, posPointW));
        }
        else if(iSect.Count == 0)
        {
          break;
        }
      }
      //Print("samkara " + pointToConsiderate.Count());
      if(pointToConsiderate.Count &gt; 2)
      {
        pointToConsiderate = pointToConsiderate.OrderBy(elm =&gt; elm.Item4).ToList();
        //Print();
        while(pointToConsiderate.Count() &gt; 1)
        {
          var curElm = pointToConsiderate.ElementAt(0);
          pointToConsiderate.RemoveAt(0);
          //Print("remkaliii");
          var nextElm = pointToConsiderate.ElementAt(0);
          Line newWall = new Line(curElm.Item1, nextElm.Item1);
          checkWallList.Add(newWall.ToNurbsCurve());
          if(nextElm.Item1.Equals(nextElm.Item2))
          {
            pointToConsiderate.RemoveAt(0);
          }
          else if(pointToConsiderate.Count &gt; 1 &amp;&amp; Math.Abs(((int) pointToConsiderate.ElementAt(1).Item3) - ((int) nextElm.Item3)) &gt; 1)
          {
            pointToConsiderate.RemoveAt(0);
          }
        }
      }
      else if(pointToConsiderate.Count == 2)
      {
        pointToConsiderate = pointToConsiderate.OrderBy(elm =&gt; elm.Item3).ToList();
        tmpTuple = pointToConsiderate.ElementAt(1);
        pointList.Insert((int) (tmpTuple.Item3 + 1), tmpTuple.Item2);
        if(!tmpTuple.Item1.Equals(tmpTuple.Item2))
        {
          pointList.Insert((int) (tmpTuple.Item3 + 1), tmpTuple.Item1);
        }
        int idxToRemove = (int) (tmpTuple.Item3);
        tmpTuple = pointToConsiderate.ElementAt(0);
        pointList.RemoveRange((int) (tmpTuple.Item3 + 1), idxToRemove - (int) (tmpTuple.Item3));
        if(!pointList.ElementAt((int) tmpTuple.Item3).Equals(tmpTuple.Item1))
        {
          pointList.Insert((int) (tmpTuple.Item3 + 1), tmpTuple.Item1);
        }
        if(!tmpTuple.Item1.Equals(tmpTuple.Item2))
        {
          pointList.Insert((int) (tmpTuple.Item3 + 1), tmpTuple.Item2);
        }
        viewArea = new Polyline(pointList);
        viewAreaCurve = viewArea.ToPolylineCurve();
      }
      //Print("sekot " + iSect.Count);
    }

    DateTime t2 = DateTime.Now;
    TimeSpan ts = t2 - t1;
    Print("tossua " + ts.TotalMilliseconds);
    //foreach(Point3d pph in pointList)
    //{
    //Print("polit " + pph);
    //}
    //Print("cudat "+DateTime.UtcNow);
