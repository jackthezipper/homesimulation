                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino as rh
import rhinoscriptsyntax as rs
import scriptcontext as sc
import Rhino.Geometry
from Rhino.Geometry import Vector3d,Point3d,Line,Polyline
import math
import time

class MyComponent(component):
    def __init__(self):
        self.pola = None
    
    def RunScript(self, x, y):
        """Provides a scripting component.
            Inputs:
                x: The x script variable
                y: The y script variable
            Output:
                a: The a output variable"""
        
        __author__ = "remote"
        __version__ = "2020.05.19"
        
        import rhinoscriptsyntax as rs
        #print x.GetType()
        rarea = rs.coercecurve(x)
        
        #Rhino.Geometry.NurbsCurve.Points
        #Rhino.Geometry.ControlPoint.Location
        #print rarea.Points[0].Location
        #print pl
        rc,pl = rarea.TryGetPolyline()
        view = sc.doc.Views.ActiveView.ActiveViewport      
        objectList = rh.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,pl,True,rh.DocObjects.ObjectType.Curve)
        sc.doc = rh.RhinoDoc.ActiveDoc
        layerIndex = sc.doc.Layers.Find("ARS_DINDING",True)
        m_wallList = [item.Geometry for item in objectList if item.Attributes.LayerIndex == layerIndex]
        print "wulan "+str(len(m_wallList))
        sc.doc = ghdoc
        
        t1 = int(time.time()*1000000)
        #vecDir = Vector3d(0,1,0)
        vecDir = rs.VectorRotate(Vector3d(0,1,0),-30,(0,0,1))
        diag = Vector3d.Subtract(Vector3d(rarea.Points[0].Location),Vector3d(rarea.Points[2].Location))
        length = diag.Length
        #print diag
        #print len
        #print "abababababababa"
        vec1 = rs.VectorRotate(vecDir,-60,(0,0,1))
        endl1 = Point3d.Add(y,(vec1*length))
        mLine1 = Line(y,endl1)
        
        vec2 = rs.VectorRotate(vecDir,60,(0,0,1))
        endl2 = Point3d.Add(y,(vec2*length))
        mLine2 = Line(y,endl2)
        #Line.to
        iSect1 = Rhino.Geometry.Intersect.Intersection.CurveCurve(rarea,mLine1.ToNurbsCurve(),0,0)
        iSect2 = Rhino.Geometry.Intersect.Intersection.CurveCurve(rarea,mLine2.ToNurbsCurve(),0,0)
        
        for inte in iSect1:
            point1 = inte.PointA
            
        for inte in iSect2:
            point2 = inte.PointA
            
        #print (mLine1.Direction/mLine1.Length)
        
        #print point1
        #print point2
        
        deg = math.degrees(math.atan2(vec1.Y,vec1.X)-math.atan2(vec2.Y,vec2.X))
        #print deg
        
        #Vector3d.Unitize(
        vpointList = []
        for poin in rarea.Points:
            vect = Vector3d.Subtract(Vector3d(poin.Location),Vector3d(y))
            vect.Unitize()
            angle = math.degrees(math.atan2(vect.Y,vect.X)-math.atan2(vec1.Y,vec1.X))
            if angle &gt;= 0 and angle &lt;= 120:
                vpointList.append((vect,poin.Location))
        #print vpointList
        
        vpointList.sort(key = lambda x: math.degrees(math.atan2(x[0].Y,x[0].X)-math.atan2(vec1.Y,vec1.X)),reverse = True)
        
        #print vpointList
        pointList = []
        pointList.append(y)
        pointList.append(point2)
        for vpoint in vpointList:
            pointList.append(vpoint[1])
        pointList.append(point1)
        pointList.append(y)
        
        #print pointList
        
        
        #view = sc.doc.Views.ActiveView.ActiveViewport      
        #objectList = rh.RhinoDoc.ActiveDoc.Objects.FindByCrossingWindowRegion(view,pointList,True,rh.DocObjects.ObjectType.Curve)
        
        #sc.doc = rh.RhinoDoc.ActiveDoc
        #layerIndex = sc.doc.Layers.Find("ARS_DINDING",True)
        #sc.doc = ghdoc
        
        #oriWallList = [item for item in objectList if item.Attributes.LayerIndex == layerIndex]
                
        mLine2.To = point2
        mLine1.To = point1
        
        #Rhino.Geometry.Curve(
        
        viewArea = Polyline(pointList)
        viewAreaCurve = viewArea.ToPolylineCurve()
        
        #print viewArea.Item
        #for i in viewArea.GetSegments():
            #print i#.GetType()
        #print "begono"
        #print pointList
        m_wallList = [item.Geometry for item in objectList if item.Attributes.LayerIndex == layerIndex]
        iterInside = 0
        iterSect = 0
        outSide = 0
        iterTot = 0
        sect1 = 0
        sect2 = 0
        sect3 = 0
        sect25 = 0
        sect23 = 0
        upV = Vector3d(0,1,0)
        t3 = int(time.time()*1000000)
        print str((t3-t1))
        testPoint = Point3d.Add(y,vecDir)
        while len(m_wallList) &gt; 0:
            ts1 = int(time.time()*1000000)
            #print "lenwa "+str(len(m_wallList))
            curWall = m_wallList.pop(0)
            #print curWall.GetType()
            iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve,curWall,0,0)
            pointToConsiderate = []
            for sect in iSect:
                iterSect+=1
                pointC,posPointC = viewAreaCurve.ClosestPoint(sect.PointA,0)
                pointW,posPointW = curWall.ClosestPoint(sect.PointA,0)
                #print "popor "+str(round(posPointW)) +" "+str(posPointW)
                closestIdx = round(posPointW) - posPointW
                if abs(closestIdx) &gt; 0.05:
                    pointToConsiderate.append((sect.PointA,sect.PointA,posPointC,posPointW))
                    #print "sexey"
                    #print sect.PointA
            isPol,pointInCurve = curWall.TryGetPolyline()
            ts2 = int(time.time()*1000000)
            ts25 = ts27 = ts22 = ts23 = 0
            for p in pointInCurve:
                iterTot += 1
                ts25 = int(time.time()*1000000)
                
                #line = Line(p,upV,length)
                #iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve,line.ToNurbsCurve(),0,0)
                #if len(iSect) % 2 == 1:
                    #pointPos = Rhino.Geometry.PointContainment.Inside
                #else:
                    #pointPos = Rhino.Geometry.PointContainment.Outside
                ts22 = int(time.time()*1000000)
                vDir = Point3d.Subtract(p,y)
                #vDir.Unitize()
                #agl = abs(math.degrees(math.atan2(p.Y-y.Y, p.X-y.X) - math.atan2(testPoint.Y-y.Y, testPoint.X-y.X)))
                agl = math.degrees(Vector3d.VectorAngle(vDir,vecDir))
                ts23 = int(time.time()*1000000)
                sect23 += (ts23-ts22)
                if agl &gt; 60:
                    continue
                pointPos = viewAreaCurve.Contains(p)
                
                #Polyline.ToPolylineCurve
                #pointPos = viewArea.ToPolylineCurve().Contains(p)
                #print pointPos
                ts27 = int(time.time()*1000000)
                sect25 += (ts27-ts25)
                #print "check "+str(p)+" "+str(pointPos)
                if pointPos == Rhino.Geometry.PointContainment.Inside:
                    iterInside += 1
                    line = Line(y,vDir,length)
                
                    iSect = Rhino.Geometry.Intersect.Intersection.CurveCurve(viewAreaCurve,line.ToNurbsCurve(),0,0)
                    
                    for sect in iSect:
                        if not sect.PointA.Equals(y):
                            pointC,posPointC = viewAreaCurve.ClosestPoint(sect.PointA,0)
                            pointW,posPointW = curWall.ClosestPoint(p,0)
                            #print "pero pero "+str(sect.PointA)+" "+str(pointC)+" "+str(posPoint)
                            pointToConsiderate.append((p,sect.PointA,posPointC,posPointW))
                elif pointPos == Rhino.Geometry.PointContainment.Coincident:
                    pointC,posPointC = viewAreaCurve.ClosestPoint(p,0)
                    pointW,posPointW = curWall.ClosestPoint(p,0)
                    pointToConsiderate.append((p,p,posPointC,posPointW))
                elif len(iSect) == 0:
                    outSide += 1
                    break
            ts3 = int(time.time()*1000000)
            #print "pomade"
            #print pointToConsiderate
            if len(pointToConsiderate) &gt; 2:
                #print "splitt"
                pointToConsiderate.sort(key = lambda x: x[3])
                #print pointToConsiderate
                #pointToConsiderate.sort(key = lambda x: x[2])
                while len(pointToConsiderate) &gt; 1:
                    curElm = pointToConsiderate.pop(0)
                    nextElm = pointToConsiderate[0]
                    newWall = Line(curElm[0],nextElm[0])
                    #print newWall
                    m_wallList.append(newWall.ToNurbsCurve())
                    
                    #at intersection
                    
                    e1 = nextElm[0]
                    e2 = nextElm[1]
                    
                    if e1.Equals(e2):
                        curElm = pointToConsiderate.pop(0)
                        
                    #different segment line
                    elif len(pointToConsiderate) &gt; 1 and abs(int(pointToConsiderate[1][2]) - int(nextElm[2])) &gt; 1:
                        curElm = pointToConsiderate.pop(0)
            elif len(pointToConsiderate) == 2:
                #print "foint"
                pointToConsiderate.sort(key = lambda x: x[2])
                #print pointToConsiderate
                #print len(pointToConsiderate)
                #print "inzana "+str(int(pointToConsiderate[0][2]+1))+" "+str(int(pointToConsiderate[1][2]+1))
                pointList.insert(int(pointToConsiderate[1][2]+1),pointToConsiderate[1][1])
                #print "p1"
                #print pointList
                if pointToConsiderate[1][0] != pointToConsiderate[1][1]:
                    pointList.insert(int(pointToConsiderate[1][2]+1),pointToConsiderate[1][0])
                    #print "p1.5"
                    #print pointList
                del pointList[int(pointToConsiderate[0][2]+1):int(pointToConsiderate[1][2]+1)]
                #print "p2"
                #print pointList
                if pointList[int(pointToConsiderate[0][2])] != pointToConsiderate[0][0]:
                    pointList.insert(int(pointToConsiderate[0][2]+1),pointToConsiderate[0][0])
                #print "p3"
                #print pointList
                if pointToConsiderate[0][0] != pointToConsiderate[0][1]:
                    pointList.insert(int(pointToConsiderate[0][2]+1),pointToConsiderate[0][1])
                    #print "p3.5"
                    #print pointList
                viewArea = Polyline(pointList)
                viewAreaCurve = viewArea.ToPolylineCurve()
                #wallList.append(curWall.Geometry)
            ts4 = int(time.time()*1000000)
            
            sect1 += (ts2-ts1)
            sect2 += (ts3-ts2)
            sect3 += (ts4-ts3)
            #print "iliterate"
            #print pointList
                
        #print"resta"
        #for po in pointList:
            #print po
        #TODO: check if only have 2 point, create new view field; if more split to several wall and continue the loop
        t2 = int(time.time()*1000000)
        print str((t2-t1))
        print iterTot
        print str(sect1)+" "+str(sect2)+" "+str(sect3)+" "+str(sect25)+" "+str(sect23)
        
        
        
        
        
        
        
        
        
        
        
        
        
